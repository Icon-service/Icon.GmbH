---
import Layout from "../layouts/Layout.astro";
import { useTranslations } from "../i18n/utils";

const lang = "de" as const;
const t = useTranslations(lang);
---

<Layout title={t("footer.legal")} description="Impressum der ICON GmbH." altPath="/en/legal-notice">
  <section class="border-b border-line">
    <div class="mx-auto max-w-(--container-wide) px-6 py-16">
      <h1 class="text-4xl sm:text-5xl">{t("footer.legal")}</h1>
    </div>
  </section>

  <section class="mx-auto max-w-(--container-wide) px-6 py-16">
    <div class="mb-8 rounded border border-signal bg-mist p-5 text-sm text-ink">
      <strong>Hinweis für ICON GmbH:</strong> Diese Seite ist ein Platzhalter-Gerüst
      und <strong>noch nicht veröffentlichungsfähig</strong>. Nach § 5 TMG sind
      Anschrift, Vertretungsberechtigte, Handelsregisterdaten und ggf. USt-IdNr.
      gesetzlich vorgeschrieben — diese Angaben liegen uns noch nicht vor und
      wurden bewusst nicht erfunden. Bitte die eckigen Platzhalter mit den
      echten Firmendaten ersetzen, bevor die Seite live geht.
    </div>

    <div class="max-w-2xl space-y-8 text-steel">
      <div>
        <h2 class="text-xl text-ink">Angaben gemäß § 5 TMG</h2>
        <p class="mt-2">
          ICON GmbH<br />
          [Straße und Hausnummer]<br />
          [PLZ und Ort]<br />
          Deutschland
        </p>
      </div>

      <div>
        <h2 class="text-xl text-ink">Vertreten durch</h2>
        <p class="mt-2">[Name der Geschäftsführung]</p>
      </div>

      <div>
        <h2 class="text-xl text-ink">Kontakt</h2>
        <p class="mt-2">
          Telefon: [Telefonnummer]<br />
          E-Mail: <a href="mailto:info@icon.gmbh" class="font-semibold text-signal hover:text-signal-dark">info@icon.gmbh</a>
        </p>
      </div>

      <div>
        <h2 class="text-xl text-ink">Registereintrag</h2>
        <p class="mt-2">
          Eintragung im Handelsregister.<br />
          Registergericht: [Registergericht]<br />
          Registernummer: [HRB-Nummer]
        </p>
      </div>

      <div>
        <h2 class="text-xl text-ink">Umsatzsteuer-ID</h2>
        <p class="mt-2">
          Umsatzsteuer-Identifikationsnummer gemäß § 27 a Umsatzsteuergesetz:<br />
          [USt-IdNr.]
        </p>
      </div>

      <div>
        <h2 class="text-xl text-ink">Verantwortlich für den Inhalt nach § 18 Abs. 2 MStV</h2>
        <p class="mt-2">
          [Name, Anschrift wie oben]
        </p>
      </div>

      <div>
        <h2 class="text-xl text-ink">EU-Streitschlichtung</h2>
        <p class="mt-2">
          Die Europäische Kommission stellt eine Plattform zur Online-Streitbeilegung (OS) bereit:
          <a href="https://ec.europa.eu/consumers/odr/" class="font-semibold text-signal hover:text-signal-dark" target="_blank" rel="noopener">
            https://ec.europa.eu/consumers/odr/
          </a>.
          Unsere E-Mail-Adresse finden Sie oben im Impressum. Wir sind nicht
          verpflichtet und nicht bereit, an Streitbeilegungsverfahren vor einer
          Verbraucherschlichtungsstelle teilzunehmen.
        </p>
      </div>
    </div>
  </section>
</Layout>
