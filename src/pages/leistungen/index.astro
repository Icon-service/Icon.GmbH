---
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import PageHero from "../../components/PageHero.astro";
import PlaceholderFrame from "../../components/PlaceholderFrame.astro";
import { leistungen } from "../../data/leistungen";
import { useTranslations, localizedPath } from "../../i18n/utils";
import { getImage } from "../../lib/images";

const lang = "de" as const;
const t = useTranslations(lang);
---

<Layout
  title={t("services.overview.title")}
  description="Containerbau, Modulbau, Stahlbau & Hallen, militärische Infrastruktur, Unterkunftsanlagen und Interim-Gebäude — die Leistungsbereiche der ICON GmbH."
  altPath="/en/services"
>
  <section class="border-b border-line">
    <PageHero
      eyebrow={t("hero.eyebrow")}
      title={t("services.overview.title")}
      lead={t("services.overview.lead")}
      image={getImage("planning-floorplan.png")}
      imageAlt="Grundriss- und Konstruktionsplanung, technische Zeichnung"
      imageCaption="ICON GmbH · Planung"
      priority
    />
  </section>

  <section class="mx-auto max-w-(--container-wide) px-6 py-16">
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {leistungen.map((l, i) => (
        <a href={localizedPath("services", lang, l.slugDe)} class="card is-interactive group block p-5">
          {(l.cardImage ?? l.heroImage) ? (
            <Image
              src={getImage(l.cardImage ?? l.heroImage!)}
              alt={l.name[lang]}
              class="mb-4 aspect-4/3 w-full rounded-lg object-cover"
              widths={[320, 480]}
              sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
            />
          ) : (
            <PlaceholderFrame label={`${l.name[lang]} Bild folgt`} class="mb-4" />
          )}
          <p class="text-sm font-bold text-steel">{String(i + 1).padStart(2, "0")}</p>
          <h2 class="mt-1 text-xl text-ink group-hover:text-signal">{l.name[lang]}</h2>
          <p class="mt-2 text-sm text-steel">{l.homeCardText[lang]}</p>
        </a>
      ))}
    </div>
  </section>
</Layout>
