---
import Layout from "../layouts/Layout.astro";
import ContactForm from "../components/ContactForm.astro";
import PageHero from "../components/PageHero.astro";
import { useTranslations } from "../i18n/utils";

const lang = "de" as const;
const t = useTranslations(lang);
---

<Layout
  title={t("contact.title")}
  description="Kontaktieren Sie ICON GmbH für Ihr Container-, Modul- oder Stahlbauprojekt."
  altPath="/en/contact"
>
  <section class="border-b border-line">
    <PageHero eyebrow={t("hero.eyebrow")} title={t("contact.title")} lead={t("contact.lead")} />
  </section>

  <section class="mx-auto max-w-(--container-wide) px-6 py-16">
    <div class="grid gap-12 lg:grid-cols-[1.3fr_1fr]">
      <ContactForm lang={lang} />

      <div class="card h-fit bg-mist p-6">
        <h2 class="text-lg text-ink">{t("contact.direct")}</h2>
        <p class="mt-4 text-steel">
          {t("footer.contact.label")}: <a href="mailto:info@icon.gmbh" class="font-semibold text-signal hover:text-signal-dark">info@icon.gmbh</a><br />
          {t("footer.contact.area")}
        </p>
        <p class="mt-6 border-t border-line pt-4 text-xs text-steel">
          Anfragen zu militärischer Infrastruktur werden vertraulich behandelt.
        </p>
      </div>
    </div>
  </section>
</Layout>
