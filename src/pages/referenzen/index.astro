---
import { Image, getImage as getAstroImage } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import PageHero from "../../components/PageHero.astro";
import Lightbox from "../../components/Lightbox.astro";
import { REFERENZEN } from "../../data/referenzen";
import { useTranslations, localizedPath } from "../../i18n/utils";
import { getImage } from "../../lib/images";

const lang = "de" as const;
const t = useTranslations(lang);

// Pre-generate a large (lightbox-sized) variant of every photo alongside the
// thumbnail — Astro's built-in getImage() (not the local lib helper) so the
// lightbox script can just swap <img src> without any runtime processing.
const groupsWithFull = await Promise.all(
  REFERENZEN.map(async (group) => {
    const images = await Promise.all(
      group.images.map(async (img) => {
        const full = await getAstroImage({ src: getImage(img.file), width: 1920 });
        return { ...img, fullSrc: full.src };
      })
    );
    return { ...group, images };
  })
);
---

<Layout
  title={t("references.title")}
  description="Reale Projekte der ICON GmbH: gehärtete Unterkunfts- und Wirtschaftsgebäude, Camp-Infrastruktur und Hallenbau in Westafrika, im Nahen Osten und im Baltikum."
  altPath="/en/references"
>
  <section class="border-b border-line">
    <PageHero
      eyebrow={t("hero.eyebrow")}
      title={t("references.title")}
      lead={t("references.lead")}
      image={getImage("projekte-hero-icon.png")}
      imageAlt="Containeranlage im Einsatz, Außenansicht"
      imageCaption="ICON GmbH · Projekteinsatz"
      priority
    />
  </section>

  <section class="mx-auto max-w-(--container-wide) px-6 py-16">
    <div class="max-w-2xl">
      <p class="text-steel">
        Aus Rücksicht auf Auftraggeber und Standort werden Projekte hier ohne Kundennamen und
        genaue Standortangaben gezeigt — die folgenden Aufnahmen stammen aus real umgesetzten
        Projekten. Klicken Sie ein Bild an, um es größer anzusehen.
      </p>
    </div>

    <div class="mt-12 space-y-16">
      {groupsWithFull.map((group) => (
        <div>
          <p class="icon-topline">{group.region[lang]}</p>
          <h2 class="mt-1.5 text-2xl text-ink sm:text-3xl">{group.title[lang]}</h2>
          <p class="mt-3 max-w-2xl text-steel">{group.text[lang]}</p>
          <div class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-5">
            {group.images.map((img, i) => (
              <button
                type="button"
                class="lightbox-trigger block text-left"
                data-group={group.id}
                data-index={i}
                data-full={img.fullSrc}
                data-caption={img.caption[lang]}
              >
                <Image
                  src={getImage(img.file)}
                  alt={img.caption[lang]}
                  class="aspect-4/3 w-full rounded-lg object-cover ring-1 ring-ink/5 transition-opacity hover:opacity-80"
                  widths={[240, 360]}
                  sizes="(min-width: 1024px) 20vw, (min-width: 640px) 33vw, 50vw"
                  loading="lazy"
                />
              </button>
            ))}
          </div>
        </div>
      ))}
    </div>

    <div class="card mt-16 bg-mist p-6 text-center sm:p-8">
      <p class="text-lg text-ink">Weitere Projekte auf Anfrage</p>
      <p class="mt-2 text-steel">Für Details zu Standort, Umfang oder Referenzauskünften sprechen Sie uns gern direkt an.</p>
      <a href={localizedPath("contact", lang)} class="btn-primary mt-6 inline-block">{t("nav.cta")}</a>
    </div>
  </section>

  <Lightbox />
</Layout>
