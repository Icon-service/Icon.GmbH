---
import Layout from "../../layouts/Layout.astro";
import PageHero from "../../components/PageHero.astro";
import { useTranslations, localizedPath } from "../../i18n/utils";
import { getImage } from "../../lib/images";

const lang = "en" as const;
const t = useTranslations(lang);

const values = [
  {
    title: "One point of contact",
    text: "A dedicated project team stays with the project from needs assessment through planning to handover.",
  },
  {
    title: "Several trades, one company",
    text: "Container, modular and steel construction are planned together at ICON, not commissioned separately.",
  },
  {
    title: "Clear documentation",
    text: "Layouts, technical documents and interfaces are prepared so decisions stay traceable.",
  },
  {
    title: "Matter-of-fact, not overstated",
    text: "Even on security-relevant projects, we stay measured, technical and discreet.",
  },
];
---

<Layout
  title={t("about.title")}
  description="ICON GmbH plans, delivers and coordinates container solutions, modular buildings, steel and hall projects, and security-relevant infrastructure."
  altPath="/ueber-uns"
>
  <section class="border-b border-line">
    <PageHero
      eyebrow={t("hero.eyebrow")}
      title={t("about.title")}
      lead="ICON plans, delivers and coordinates container solutions, modular buildings, steel and hall projects, and security-relevant infrastructure — for sites that need to move fast, hold up, and stay well documented."
      image={getImage("stahlbau-schweissarbeiten.jpg")}
      imageAlt="Welding work on an ICON steel structure"
      imageCaption="ICON GmbH · Fabrication"
      priority
    />
  </section>

  <section class="mx-auto max-w-(--container-wide) px-6 py-16">
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {values.map((v) => (
        <div class="border-l-2 border-signal pl-4">
          <h2 class="text-lg text-ink">{v.title}</h2>
          <p class="mt-2 text-sm text-steel">{v.text}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="border-t border-line bg-mist py-16 text-center">
    <div class="mx-auto max-w-(--container-wide) px-6">
      <h2 class="text-3xl text-ink">Planning a project?</h2>
      <a href={localizedPath("contact", lang)} class="btn-primary mt-6 inline-block">{t("nav.cta")}</a>
    </div>
  </section>
</Layout>
