---
import Layout from "../../layouts/Layout.astro";
import { useTranslations } from "../../i18n/utils";

const lang = "en" as const;
const t = useTranslations(lang);
---

<Layout title={t("footer.privacy")} description="Privacy policy for ICON GmbH." altPath="/datenschutz">
  <section class="border-b border-line">
    <div class="mx-auto max-w-(--container-wide) px-6 py-16">
      <h1 class="text-4xl sm:text-5xl">{t("footer.privacy")}</h1>
    </div>
  </section>

  <section class="mx-auto max-w-(--container-wide) px-6 py-16">
    <div class="mb-8 rounded border border-signal bg-mist p-5 text-sm text-ink">
      <strong>Note for ICON GmbH:</strong> This text is a technically accurate
      draft based on the tools actually used (Formspree for the contact form,
      no hosting provider fixed yet, no cookies/tracking). It is
      <strong>not legal advice</strong> — please have it reviewed by a lawyer
      or a generator such as eRecht24 before publishing, especially once the
      hosting provider, business address, and any analytics tools are
      finalized. The German <a href="/datenschutz" class="font-semibold text-signal hover:text-signal-dark">Datenschutzerklärung</a> is the legally binding version.
    </div>

    <div class="max-w-2xl space-y-8 text-steel">
      <div>
        <h2 class="text-xl text-ink">Data controller</h2>
        <p class="mt-2">
          ICON GmbH<br />
          [Street and number]<br />
          [Postal code and city]<br />
          Email: <a href="mailto:info@icon.gmbh" class="font-semibold text-signal hover:text-signal-dark">info@icon.gmbh</a>
        </p>
      </div>

      <div>
        <h2 class="text-xl text-ink">Hosting</h2>
        <p class="mt-2">
          This website is hosted by [hosting provider, to be added once
          decided]. When you visit the site, the hosting provider
          automatically collects technical access data (e.g. IP address,
          date and time of access, page requested, browser used) in server
          log files. This is based on our legitimate interest in operating a
          secure and stable website (Art. 6(1)(f) GDPR).
        </p>
      </div>

      <div>
        <h2 class="text-xl text-ink">Contact form</h2>
        <p class="mt-2">
          If you send us an enquiry via the contact form, the information
          you provide (name, company, email address, phone number, message)
          is processed for the purpose of handling your enquiry (Art.
          6(1)(b) GDPR).
        </p>
        <p class="mt-3">
          Submission is technically handled by the form service Formspree,
          Inc. (USA). Data may therefore be transferred to the US. Formspree
          processes the data on our behalf under EU standard contractual
          clauses or an equivalent adequacy mechanism. More information:
          <a href="https://formspree.io/legal/privacy-policy/" class="font-semibold text-signal hover:text-signal-dark" target="_blank" rel="noopener">
            formspree.io/legal/privacy-policy
          </a>.
        </p>
      </div>

      <div>
        <h2 class="text-xl text-ink">Cookies and tracking</h2>
        <p class="mt-2">
          This website currently uses no cookies and no analytics or
          tracking tools. Should that change, this policy will be updated
          accordingly and consent obtained where required.
        </p>
      </div>

      <div>
        <h2 class="text-xl text-ink">Retention</h2>
        <p class="mt-2">
          Enquiry data is deleted once it is no longer required to handle
          your request, unless statutory retention obligations apply.
        </p>
      </div>

      <div>
        <h2 class="text-xl text-ink">Your rights</h2>
        <p class="mt-2">
          You have the right to access, rectify, erase and restrict the
          processing of your personal data, as well as a right to data
          portability and to object to processing. You also have the right
          to lodge a complaint with a data protection supervisory authority.
          Contact us at <a href="mailto:info@icon.gmbh" class="font-semibold text-signal hover:text-signal-dark">info@icon.gmbh</a>.
        </p>
      </div>
    </div>
  </section>
</Layout>
