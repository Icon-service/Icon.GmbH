---
import Layout from "../../../layouts/Layout.astro";
import { useTranslations, localizedPath } from "../../../i18n/utils";

const lang = "en" as const;
const t = useTranslations(lang);
---

<Layout
  title={t("references.title")}
  description="Reference projects by ICON GmbH."
  altPath="/referenzen"
>
  <section class="border-b border-line">
    <div class="mx-auto max-w-(--container-wide) px-6 py-16">
      <p class="icon-topline">{t("hero.eyebrow")}</p>
      <h1 class="mt-3 text-4xl sm:text-5xl">{t("references.title")}</h1>
      <p class="mt-4 max-w-xl text-lg text-steel">{t("references.lead")}</p>
    </div>
  </section>

  <section class="mx-auto max-w-(--container-wide) px-6 py-20">
    <div class="card mx-auto max-w-lg bg-mist p-8 text-center">
      <h2 class="text-2xl text-ink">{t("references.empty.title")}</h2>
      <p class="mt-3 text-steel">{t("references.empty.text")}</p>
      <a href={localizedPath("contact", lang)} class="btn-primary mt-6 inline-block">{t("nav.cta")}</a>
    </div>
  </section>
</Layout>
