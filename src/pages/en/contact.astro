---
import Layout from "../../layouts/Layout.astro";
import ContactForm from "../../components/ContactForm.astro";
import { useTranslations } from "../../i18n/utils";

const lang = "en" as const;
const t = useTranslations(lang);
---

<Layout
  title={t("contact.title")}
  description="Contact ICON GmbH about your container, modular or steel construction project."
  altPath="/kontakt"
>
  <section class="border-b border-line">
    <div class="mx-auto max-w-(--container-wide) px-6 py-16">
      <p class="icon-topline">{t("hero.eyebrow")}</p>
      <h1 class="mt-3 text-4xl sm:text-5xl">{t("contact.title")}</h1>
      <p class="mt-4 max-w-xl text-lg text-steel">{t("contact.lead")}</p>
    </div>
  </section>

  <section class="mx-auto max-w-(--container-wide) px-6 py-16">
    <div class="grid gap-12 lg:grid-cols-[1.3fr_1fr]">
      <ContactForm lang={lang} />

      <div class="h-fit rounded border border-line bg-mist p-6">
        <h2 class="text-lg text-ink">{t("contact.direct")}</h2>
        <p class="mt-4 text-steel">
          {t("footer.contact.label")}: <a href="mailto:info@icon.gmbh" class="font-semibold text-signal hover:text-signal-dark">info@icon.gmbh</a><br />
          {t("footer.contact.area")}
        </p>
        <p class="mt-6 border-t border-line pt-4 text-xs text-steel">
          Enquiries about defense infrastructure are handled confidentially.
        </p>
      </div>
    </div>
  </section>
</Layout>
