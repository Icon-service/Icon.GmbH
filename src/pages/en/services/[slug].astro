---
import Layout from "../../../layouts/Layout.astro";
import { leistungen } from "../../../data/leistungen";
import { useTranslations, localizedPath } from "../../../i18n/utils";

export function getStaticPaths() {
  return leistungen.map((l) => ({
    params: { slug: l.slugEn },
    props: { leistung: l },
  }));
}

const lang = "en" as const;
const t = useTranslations(lang);
const { leistung } = Astro.props;
---

<Layout
  title={leistung.name[lang]}
  description={leistung.heroLead[lang]}
  altPath={`/leistungen/${leistung.slugDe}`}
>
  <section class="border-b border-line">
    <div class="mx-auto max-w-(--container-wide) px-6 py-16">
      <a href={localizedPath("services", lang)} class="text-sm font-semibold text-steel hover:text-signal">
        ← {t("services.overview.title")}
      </a>
      <h1 class="mt-3 text-4xl sm:text-5xl">{leistung.name[lang]}</h1>
      <p class="mt-4 max-w-2xl text-lg text-steel">{leistung.heroLead[lang]}</p>
    </div>
  </section>

  <section class="mx-auto max-w-(--container-wide) px-6 py-16">
    <p class="max-w-2xl text-steel">
      A full English version of this page is in progress —
      <a href={`/leistungen/${leistung.slugDe}`} class="font-semibold text-signal hover:text-signal-dark">
        read the complete German page
      </a>
      in the meantime, or get in touch directly.
    </p>

    <div class="mt-10 rounded border border-line bg-mist p-6 sm:p-8">
      <p class="text-lg text-ink">Planning a project in this area?</p>
      <div class="mt-4 flex flex-wrap gap-4">
        <a href={leistung.ctaHref ?? localizedPath("contact", lang)} class="btn-primary">
          {leistung.ctaLabel?.[lang] ?? t("nav.cta")}
        </a>
      </div>
    </div>
  </section>
</Layout>
