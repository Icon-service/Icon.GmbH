---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import { useTranslations, localizedPath } from "../i18n/utils";
import { getImage } from "../lib/images";

const lang = "de" as const;
const t = useTranslations(lang);

const values = [
  {
    title: "Ein Ansprechpartner",
    text: "Von Bedarfsklärung über Planung bis Übergabe begleitet ein festes Projektteam das Vorhaben.",
  },
  {
    title: "Mehrere Gewerke, ein Haus",
    text: "Containerbau, Modulbau und Stahlbau werden bei ICON zusammen gedacht statt getrennt beauftragt.",
  },
  {
    title: "Klare Dokumentation",
    text: "Grundrisse, technische Unterlagen und Schnittstellen werden nachvollziehbar aufbereitet.",
  },
  {
    title: "Sachlich statt reißerisch",
    text: "Auch bei sicherheitsrelevanten Projekten bleiben wir zurückhaltend, fachlich und diskret.",
  },
];
---

<Layout
  title={t("about.title")}
  description="ICON GmbH plant, liefert und koordiniert Containerlösungen, modulare Gebäude, Stahlbau- und Hallenprojekte sowie sicherheitsrelevante Infrastruktur."
  altPath="/en/about"
>
  <section class="border-b border-line">
    <PageHero
      eyebrow={t("hero.eyebrow")}
      title={t("about.title")}
      lead="ICON plant, liefert und koordiniert Containerlösungen, modulare Gebäude, Stahlbau- und Hallenprojekte sowie sicherheitsrelevante Infrastruktur — für Standorte, die schnell, belastbar und sauber dokumentiert umgesetzt werden müssen."
      image={getImage("stahlbau-schweissarbeiten.jpg")}
      imageAlt="Schweißarbeiten an einer Stahlkonstruktion von ICON"
      imageCaption="ICON GmbH · Fertigung"
      priority
    />
  </section>

  <section class="mx-auto max-w-(--container-wide) px-6 py-16">
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {values.map((v) => (
        <div class="border-l-2 border-signal pl-4">
          <h2 class="text-lg text-ink">{v.title}</h2>
          <p class="mt-2 text-sm text-steel">{v.text}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="border-t border-line bg-mist py-16 text-center">
    <div class="mx-auto max-w-(--container-wide) px-6">
      <h2 class="text-3xl text-ink">Sie planen ein Projekt?</h2>
      <a href={localizedPath("contact", lang)} class="btn-primary mt-6 inline-block">{t("nav.cta")}</a>
    </div>
  </section>
</Layout>
