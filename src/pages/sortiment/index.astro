---
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import PageHero from "../../components/PageHero.astro";
import PlaceholderFrame from "../../components/PlaceholderFrame.astro";
import { sortiment } from "../../data/sortiment";
import { useTranslations, localizedPath } from "../../i18n/utils";
import { getImage } from "../../lib/images";

const lang = "de" as const;
const t = useTranslations(lang);

// Only the Bürocontainer product has real photography so far.
const cardImage: Record<string, string> = {
  buerocontainer: "buerocontainer-aussenansicht-fenster.png",
};
---

<Layout
  title={t("sortiment.overview.title")}
  description="Bürocontainer, Wohn- und Unterkunftscontainer, Sanitärcontainer, Schulcontainer und Bildungsgebäude, Baustellencontainer, Aufenthalts- und Sozialräume — das Sortiment der ICON GmbH."
  altPath="/en/sortiment"
>
  <section class="border-b border-line">
    <PageHero
      eyebrow={t("hero.eyebrow")}
      title={t("sortiment.overview.title")}
      lead={t("sortiment.overview.lead")}
      image={getImage("buerocontainer-aussenansicht-fenster.png")}
      imageAlt="Bürocontainer von ICON, Außenansicht"
      imageCaption="ICON GmbH · Sortiment"
      priority
    />
  </section>

  <section class="mx-auto max-w-(--container-wide) px-6 pt-16">
    <div class="card flex flex-wrap items-center justify-between gap-5 border-l-2 border-signal p-6 sm:p-8">
      <div>
        <p class="icon-topline">Neu</p>
        <h2 class="mt-1.5 text-xl text-ink">Grundrissplaner: Container selbst anordnen</h2>
        <p class="mt-2 max-w-xl text-sm text-steel">
          Ordnen Sie unsere Container in Standardgrößen selbst auf einem Raster an und senden Sie Ihren Entwurf direkt als Skizze mit Ihrer Anfrage.
        </p>
      </div>
      <a href="/grundrissplaner" class="btn-primary shrink-0">Grundrissplaner öffnen</a>
    </div>
  </section>

  <section class="mx-auto max-w-(--container-wide) px-6 py-16">
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {sortiment.map((p) => (
        <a href={localizedPath("sortiment", lang, p.slugDe)} class="card is-interactive group block p-5">
          {cardImage[p.id] ? (
            <Image
              src={getImage(cardImage[p.id])}
              alt={p.name[lang]}
              class="mb-4 aspect-4/3 w-full rounded-lg object-cover"
              widths={[320, 480]}
              sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
            />
          ) : (
            <PlaceholderFrame label={`${p.name[lang]} Bild folgt`} class="mb-4" />
          )}
          <h2 class="text-xl text-ink group-hover:text-signal">{p.name[lang]}</h2>
          <p class="mt-2 text-sm text-steel">{p.excerpt[lang]}</p>
        </a>
      ))}
    </div>
  </section>
</Layout>
