---
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import BlockRenderer from "../../components/BlockRenderer.astro";
import PlaceholderFrame from "../../components/PlaceholderFrame.astro";
import TechSpecSheet from "../../components/TechSpecSheet.astro";
import { sortiment } from "../../data/sortiment";
import { useTranslations, localizedPath } from "../../i18n/utils";
import { getImage } from "../../lib/images";
import { floorplanSvg } from "../../lib/floorplan";

export function getStaticPaths() {
  return sortiment.map((p) => ({
    params: { slug: p.slugDe },
    props: { product: p },
  }));
}

const lang = "de" as const;
const t = useTranslations(lang);
const { product } = Astro.props;

// Only Bürocontainer has real photography recovered from the old site so far.
const gallery =
  product.id === "buerocontainer"
    ? [
        { file: "buerocontainer-aussenansicht-fenster.png", caption: "Bürocontainer, Außenansicht" },
        { file: "buerocontainer-20-fuss-innenansicht.png", caption: "Bürocontainer 20', Innenansicht" },
        { file: "buerocontainer-aussenansicht-tuer.png", caption: "Bürocontainer, Eingangsseite" },
        { file: "buerocontainer-rahmen-detail.png", caption: "Rahmenkonstruktion, Detail" },
      ]
    : [];

const specRows = [
  t("sortiment.specs.dimensions"),
  t("sortiment.specs.layout"),
  t("sortiment.specs.technical"),
  t("sortiment.specs.fitout"),
  t("sortiment.specs.downloads"),
];
---

<Layout
  title={product.name[lang]}
  description={product.heroLead[lang]}
  altPath={`/en/sortiment/${product.slugEn}`}
>
  <section class="border-b border-line">
    <div class="mx-auto max-w-(--container-wide) px-6 py-16">
      <a href={localizedPath("sortiment", lang)} class="text-sm font-semibold text-steel hover:text-signal">
        ← {t("sortiment.overview.title")}
      </a>
      <div class="mt-4 flex items-center gap-3">
        <span class="h-[2px] w-8 bg-signal" aria-hidden="true"></span>
        <p class="icon-topline">{t("sortiment.overview.title")}</p>
      </div>
      <h1 class="mt-4 text-4xl sm:text-5xl">{product.name[lang]}</h1>
      <p class="mt-4 max-w-2xl text-lg text-steel">{product.heroLead[lang]}</p>
      {product.introExtra && <p class="mt-3 max-w-2xl text-steel">{product.introExtra}</p>}
    </div>

    {gallery.length > 0 ? (
      <div class="mx-auto grid max-w-(--container-wide) grid-cols-2 gap-3 px-6 pb-2 lg:grid-cols-4">
        {gallery.map((g) => (
          <figure>
            <Image
              src={getImage(g.file)}
              alt={g.caption}
              class="aspect-4/3 w-full rounded-lg object-cover ring-1 ring-ink/5"
              widths={[320, 480]}
              sizes="(min-width: 1024px) 25vw, 50vw"
            />
            <figcaption class="mt-1.5 text-xs text-steel">{g.caption}</figcaption>
          </figure>
        ))}
      </div>
    ) : (
      <div class="mx-auto max-w-(--container-wide) px-6 pb-2">
        <PlaceholderFrame label={`${product.name[lang]} Bild folgt`} />
      </div>
    )}
  </section>

  <section class="mx-auto max-w-(--container-wide) px-6 py-16">
    <h2 class="text-2xl sm:text-3xl">{t("sortiment.variants.title")}</h2>
    {product.categories.map((cat) => (
      <div class="mt-8 first:mt-6">
        <p class="icon-topline">{cat.label}</p>
        <div class="mt-4 grid gap-4 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5">
          {cat.types.map((t2) => (
            <div class="rounded-lg border border-line bg-paper p-3">
              <p class="text-xs text-steel">{t2.name}</p>
              <div class="mt-2 flex justify-center rounded bg-mist/60 py-2" set:html={floorplanSvg(t2, cat.key)} />
            </div>
          ))}
        </div>
      </div>
    ))}

    <div class="mt-14">
      <BlockRenderer blocks={product.detailBlocksDe} />
    </div>

    {product.technicalDescription && (
      <div class="mt-14">
        <h2 class="text-2xl sm:text-3xl">Technische Beschreibung</h2>
        <div class="mt-6">
          <TechSpecSheet spec={product.technicalDescription} />
        </div>
      </div>
    )}

    {product.technicalDescription ? (
      <div class="card mt-14 bg-mist p-6 sm:p-8">
        <p class="text-lg text-ink">Fragen zu diesem Produkt?</p>
        <a href={localizedPath("contact", lang)} class="btn-primary mt-4 inline-block">
          {t("nav.cta")}
        </a>
      </div>
    ) : (
      <div class="card mt-14 bg-mist p-6 sm:p-8">
        <h2 class="text-xl text-ink">{t("sortiment.specs.title")}</h2>
        <p class="mt-3 text-steel">{t("sortiment.specs.lead")}</p>
        <ul class="mt-4 space-y-2">
          {specRows.map((row) => (
            <li class="border-l-2 border-line pl-3 text-sm text-steel">{row}</li>
          ))}
        </ul>
        <a href={localizedPath("contact", lang)} class="btn-primary mt-6 inline-block">
          {t("nav.cta")}
        </a>
      </div>
    )}
  </section>
</Layout>
