---
import type { ModulSystem } from "../data/modulSystem";

type Props = { system: ModulSystem };
const { system } = Astro.props as Props;
---

<div class="space-y-12">
  <p class="max-w-2xl text-lg text-steel">{system.intro}</p>

  <div class="card grid gap-8 p-6 sm:p-8 lg:grid-cols-[1fr_auto] lg:items-center">
    <div>
      <h3 class="text-xl text-ink">{system.grid.title}</h3>
      <p class="mt-3 text-steel">{system.grid.text}</p>
    </div>
    <div class="grid grid-cols-6 gap-1 justify-self-center" aria-hidden="true">
      {Array.from({ length: 24 }).map((_, i) => (
        <span class={`h-6 w-6 sm:h-7 sm:w-7 border border-line ${[2, 7, 8, 14, 19, 20].includes(i) ? "bg-signal/80" : "bg-mist"}`}></span>
      ))}
    </div>
  </div>

  <div>
    <h3 class="text-xl text-ink">Das G-CAP Baukastenprinzip</h3>
    <div class="mt-5 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {system.usps.map((usp) => (
        <div class="card p-5">
          <h4 class="text-lg text-ink">{usp.title}</h4>
          <p class="mt-2 text-sm text-steel">{usp.text}</p>
        </div>
      ))}
    </div>
  </div>

  <div class="card bg-ink p-5 text-paper sm:p-6">
    <p class="icon-topline">Tragwerk</p>
    <dl class="mt-4 grid gap-4 sm:grid-cols-2">
      {system.frame.map((row) => (
        <div>
          <dt class="text-xs font-bold uppercase tracking-wide text-mist/60">{row.label}</dt>
          <dd class="mt-0.5 text-sm text-mist">{row.value}</dd>
        </div>
      ))}
    </dl>
  </div>

  <div>
    <h3 class="text-xl text-ink">Wandaufbau, Boden und Dach</h3>
    <div class="mt-5 grid gap-5 sm:grid-cols-2">
      {system.buildups.map((b) => (
        <div class="card p-5">
          <div class="flex items-baseline justify-between gap-3">
            <p class="icon-topline">{b.heading}</p>
            <p class="text-sm font-bold text-steel">{b.totalThickness}</p>
          </div>
          <ol class="mt-3 space-y-1.5">
            {b.layers.map((layer, i) => (
              <li class="flex gap-2 text-sm text-ink">
                <span class="text-steel">{String(i + 1).padStart(2, "0")}</span>
                <span>{layer}</span>
              </li>
            ))}
          </ol>
          {b.note && <p class="mt-3 border-t border-line pt-3 text-xs text-steel">{b.note}</p>}
        </div>
      ))}
    </div>
  </div>

  <div class="card bg-mist p-5 text-sm text-ink">{system.stackingNote}</div>

  <p class="text-xs text-steel">{system.sourceNote}</p>
</div>
