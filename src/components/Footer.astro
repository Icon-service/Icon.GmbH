---
import { getLangFromUrl, useTranslations, localizedPath } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="bg-ink text-paper">
  <div class="mx-auto max-w-(--container-wide) px-6 py-12">
    <div class="grid gap-8 md:grid-cols-2">
      <div>
        <span class="text-xl font-extrabold">ICON GmbH</span>
        <p class="mt-3 max-w-sm text-[0.98rem] text-mist">{t("footer.claim")}</p>
      </div>
      <div class="md:text-right">
        <p class="text-[0.95rem] text-mist">
          {t("footer.contact.label")}: <a href="mailto:info@icon.gmbh" class="text-paper hover:text-signal">info@icon.gmbh</a><br />
          {t("footer.contact.area")}
        </p>
      </div>
    </div>

    <div class="mt-10 flex flex-col gap-3 border-t border-white/10 pt-6 text-xs text-mist/70 sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} ICON GmbH — {t("footer.rights")}</p>
      <div class="flex gap-6">
        <a href={localizedPath("legal", lang)} class="hover:text-signal">{t("footer.legal")}</a>
        <a href={localizedPath("privacy", lang)} class="hover:text-signal">{t("footer.privacy")}</a>
      </div>
    </div>
  </div>
</footer>
