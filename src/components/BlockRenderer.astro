---
import type { Block } from "../data/leistungen";

type Props = { blocks: Block[] };
const { blocks } = Astro.props as Props;
---

<div class="space-y-14">
  {blocks.map((block) => {
    if (block.type === "paragraphs") {
      return (
        <section>
          {block.heading && <h2 class="max-w-2xl text-2xl sm:text-3xl">{block.heading}</h2>}
          <div class={`space-y-3 text-steel ${block.heading ? "mt-4" : ""} max-w-2xl`}>
            {block.text.map((p) => <p>{p}</p>)}
          </div>
        </section>
      );
    }
    if (block.type === "list") {
      return (
        <section>
          {block.heading && <h2 class="text-2xl sm:text-3xl">{block.heading}</h2>}
          <ul class={`space-y-2.5 ${block.heading ? "mt-4" : ""}`}>
            {block.items.map((item) => (
              <li class="border-l-2 border-signal pl-3 text-steel">{item}</li>
            ))}
          </ul>
        </section>
      );
    }
    if (block.type === "columns") {
      return (
        <section>
          {block.heading && <h2 class="text-2xl sm:text-3xl">{block.heading}</h2>}
          {block.intro && <p class="mt-3 max-w-2xl text-steel">{block.intro}</p>}
          <div class="mt-5 grid gap-8 sm:grid-cols-2">
            {block.columns.map((col) => (
              <div>
                {col.heading && <h3 class="text-lg text-ink">{col.heading}</h3>}
                <ul class={`space-y-2 ${col.heading ? "mt-3" : ""}`}>
                  {col.items.map((item) => (
                    <li class="border-l-2 border-line pl-3 text-steel">{item}</li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </section>
      );
    }
    if (block.type === "cards") {
      return (
        <section>
          {block.heading && <h2 class="text-2xl sm:text-3xl">{block.heading}</h2>}
          <div class={`grid gap-6 sm:grid-cols-3 ${block.heading ? "mt-5" : ""}`}>
            {block.cards.map((card) => (
              <div class="rounded border border-line p-5">
                <h3 class="text-lg text-ink">{card.title}</h3>
                <p class="mt-2 text-sm text-steel">{card.text}</p>
              </div>
            ))}
          </div>
        </section>
      );
    }
    if (block.type === "spec") {
      return (
        <section class="rounded bg-ink p-6 text-paper sm:p-8">
          {block.heading && <h2 class="max-w-xl text-2xl text-paper sm:text-3xl">{block.heading}</h2>}
          <div class={`grid gap-6 sm:grid-cols-2 ${block.heading ? "mt-6" : ""}`}>
            {block.items.map((item) => (
              <div>
                <h3 class="text-base font-bold text-paper">{item.label}</h3>
                <p class="mt-1.5 text-sm text-mist">{item.text}</p>
              </div>
            ))}
          </div>
        </section>
      );
    }
    if (block.type === "steps") {
      return (
        <section>
          {block.heading && <h2 class="text-2xl sm:text-3xl">{block.heading}</h2>}
          <ol class={`grid gap-6 sm:grid-cols-3 ${block.heading ? "mt-5" : ""}`}>
            {block.items.map((item, i) => (
              <li>
                <p class="text-sm font-bold text-signal">{String(i + 1).padStart(2, "0")}</p>
                <h3 class="mt-1 text-lg text-ink">{item.label}</h3>
                <p class="mt-1.5 text-sm text-steel">{item.text}</p>
              </li>
            ))}
          </ol>
        </section>
      );
    }
    return null;
  })}
</div>
