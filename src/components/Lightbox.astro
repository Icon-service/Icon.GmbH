---
// Shared lightbox overlay + controller. Include once per page. Any element
// with class="lightbox-trigger" and data-group / data-index / data-full /
// data-caption attributes will open it, scoped to its data-group so arrow
// navigation stays within that project's photo set.
---

<div id="lightbox" class="fixed inset-0 z-50 hidden bg-ink/95 backdrop-blur-sm" role="dialog" aria-modal="true" aria-label="Bildansicht">
  <button type="button" id="lightbox-close" aria-label="Schließen" class="absolute right-3 top-3 z-10 flex h-10 w-10 items-center justify-center rounded-full bg-paper/10 text-2xl text-paper hover:bg-paper/20 sm:right-6 sm:top-6">
    &times;
  </button>

  <button type="button" id="lightbox-prev" aria-label="Vorheriges Bild" class="absolute left-1 top-1/2 z-10 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full bg-paper/10 text-2xl text-paper hover:bg-paper/20 sm:left-4">
    &#8249;
  </button>
  <button type="button" id="lightbox-next" aria-label="Nächstes Bild" class="absolute right-1 top-1/2 z-10 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full bg-paper/10 text-2xl text-paper hover:bg-paper/20 sm:right-4">
    &#8250;
  </button>

  <div id="lightbox-stage" class="flex h-full w-full items-center justify-center overflow-hidden p-6 sm:p-16">
    <img
      id="lightbox-img"
      alt=""
      class="max-h-full max-w-full cursor-zoom-in object-contain transition-transform duration-200 ease-out"
    />
  </div>

  <p id="lightbox-counter" class="absolute left-4 top-4 text-xs font-semibold text-mist sm:left-6 sm:top-6"></p>
  <p id="lightbox-caption" class="absolute bottom-4 left-1/2 max-w-[90vw] -translate-x-1/2 text-center text-sm text-mist sm:bottom-6"></p>
</div>

<script>
  type Trigger = {
    el: HTMLElement;
    group: string;
    index: number;
    full: string;
    caption: string;
  };

  const overlay = document.getElementById("lightbox");
  const img = document.getElementById("lightbox-img") as HTMLImageElement | null;
  const captionEl = document.getElementById("lightbox-caption");
  const counterEl = document.getElementById("lightbox-counter");
  const closeBtn = document.getElementById("lightbox-close");
  const prevBtn = document.getElementById("lightbox-prev");
  const nextBtn = document.getElementById("lightbox-next");
  const stage = document.getElementById("lightbox-stage");

  let current: Trigger[] = [];
  let currentIndex = 0;
  let zoomed = false;

  function getTriggers(group: string): Trigger[] {
    return Array.from(document.querySelectorAll<HTMLElement>(`.lightbox-trigger[data-group="${group}"]`))
      .map((el) => ({
        el,
        group,
        index: Number(el.dataset.index),
        full: el.dataset.full ?? "",
        caption: el.dataset.caption ?? "",
      }))
      .sort((a, b) => a.index - b.index);
  }

  function render() {
    if (!img || !overlay) return;
    const item = current[currentIndex];
    if (!item) return;
    zoomed = false;
    img.classList.remove("scale-200", "cursor-zoom-out");
    img.classList.add("cursor-zoom-in");
    img.style.transform = "";
    img.src = item.full;
    img.alt = item.caption;
    if (captionEl) captionEl.textContent = item.caption;
    if (counterEl) counterEl.textContent = `${currentIndex + 1} / ${current.length}`;
  }

  function open(group: string, index: number) {
    current = getTriggers(group);
    currentIndex = Math.max(0, current.findIndex((t) => t.index === index));
    if (!overlay) return;
    overlay.classList.remove("hidden");
    document.body.style.overflow = "hidden";
    render();
  }

  function close() {
    if (!overlay) return;
    overlay.classList.add("hidden");
    document.body.style.overflow = "";
  }

  function step(delta: number) {
    if (current.length === 0) return;
    currentIndex = (currentIndex + delta + current.length) % current.length;
    render();
  }

  document.querySelectorAll<HTMLElement>(".lightbox-trigger").forEach((el) => {
    el.addEventListener("click", () => {
      const group = el.dataset.group ?? "";
      const index = Number(el.dataset.index);
      open(group, index);
    });
  });

  closeBtn?.addEventListener("click", close);
  prevBtn?.addEventListener("click", () => step(-1));
  nextBtn?.addEventListener("click", () => step(1));

  overlay?.addEventListener("click", (evt) => {
    if (evt.target === overlay || evt.target === stage) close();
  });

  img?.addEventListener("click", (evt) => {
    evt.stopPropagation();
    zoomed = !zoomed;
    if (zoomed) {
      img.classList.remove("cursor-zoom-in");
      img.classList.add("cursor-zoom-out");
      img.style.transform = "scale(2)";
    } else {
      img.classList.remove("cursor-zoom-out");
      img.classList.add("cursor-zoom-in");
      img.style.transform = "";
    }
  });

  img?.addEventListener("mousemove", (evt) => {
    if (!zoomed || !img) return;
    const rect = img.getBoundingClientRect();
    const x = ((evt.clientX - rect.left) / rect.width) * 100;
    const y = ((evt.clientY - rect.top) / rect.height) * 100;
    img.style.transformOrigin = `${x}% ${y}%`;
  });

  document.addEventListener("keydown", (evt) => {
    if (!overlay || overlay.classList.contains("hidden")) return;
    if (evt.key === "Escape") close();
    else if (evt.key === "ArrowLeft") step(-1);
    else if (evt.key === "ArrowRight") step(1);
  });
</script>
