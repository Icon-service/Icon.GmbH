    if(sourceOpenings.length===0){alert("Bitte zuerst mindestens eine Tür oder ein Fenster auf diesem Modul platzieren.");return;}
    const targets=items.filter(i=>i.id!==source.id && i.productId===source.productId && i.size===source.size && i.rot===source.rot);
    for(const target of targets){
      elements=elements.filter(e=>e.containerId!==target.id || (e.type!=="door"&&e.type!=="window"));
      for(const src of sourceOpenings){
        const spanSrc=(src.side==="top"||src.side==="bottom")?source.width:source.length;
        const spanDst=(src.side==="top"||src.side==="bottom")?target.width:target.length;
        const ratio=spanSrc>0?src.offset/spanSrc:.5;
        elements.push({...src,id:nextId++,containerId:target.id,offset:snap(ratio*spanDst,.05)});
