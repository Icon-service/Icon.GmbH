  function cloneModuleData(source, x, y){
    const clone={...source,id:nextId++,x,y,groupId:null,outerWallMm:projectOuterWallMm,innerWallMm:projectInnerWallMm};
    items.push(clone);
    const attached=elements.filter(e=>e.containerId===source.id && (e.type==="door"||e.type==="window"));
    for(const e of attached) elements.push({...e,id:nextId++,containerId:clone.id});
    return clone;
  }

  function captureSelectedModule(){
    const source=selectedContainer();
    if(!source || selectedContainerIds.size!==1) return null;
    moduleClipboard={
      module:{...source,groupId:null,outerWallMm:projectOuterWallMm,innerWallMm:projectInnerWallMm},
      openings:elements.filter(e=>e.containerId===source.id && (e.type==="door"||e.type==="window")).map(e=>({...e}))
    };
    pasteModuleBtn.disabled=false;
    return source;
  }

  copyModuleBtn?.addEventListener("click",()=>{
