    </label>

    <input type="hidden" name="_subject" value={lang === "de" ? "Grundriss-Skizze über icon-gmbh.de" : "Floor plan sketch via icon-gmbh.de"} />

    <button type="submit" class="btn-primary sm:col-span-2 mt-1 w-fit">
      {lang === "de" ? "Skizze mit Anfrage senden" : "Send sketch with enquiry"}
    </button>

    <p class="planner-form-status sm:col-span-2 hidden text-sm" role="status"></p>
