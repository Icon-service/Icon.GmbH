    alert(`${sourceOpenings.length} Öffnung(en) auf ${targets.length} gleiche Module übernommen.`);
    render();
  });

  document.addEventListener("keydown",evt=>{ if(!selected && selectedContainerIds.size===0 && selectedElementIds.size===0)return; const active=document.activeElement;if(active&&["INPUT","TEXTAREA","SELECT"].includes(active.tagName))return; const c=selectedContainer(),e=selectedElement(); if(evt.key==="Delete"||evt.key==="Backspace"){deleteBtn.click();evt.preventDefault();return;} if(evt.key.toLowerCase()==="r"&&c){rotateBtn.click();evt.preventDefault();return;} const step=.1; let handled=true; if(c){const fp=footprint(c);if(evt.key==="ArrowLeft")c.x=clamp(c.x-step,0,worldW-fp.w);else if(evt.key==="ArrowRight")c.x=clamp(c.x+step,0,worldW-fp.w);else if(evt.key==="ArrowUp")c.y=clamp(c.y-step,0,worldH-fp.h);else if(evt.key==="ArrowDown")c.y=clamp(c.y+step,0,worldH-fp.h);else handled=false;} else if(e&&e.type!=="wall"){if(e.type==="stair"){if(evt.key==="ArrowLeft")e.x-=step;else if(evt.key==="ArrowRight")e.x+=step;else if(evt.key==="ArrowUp")e.y-=step;else if(evt.key==="ArrowDown")e.y+=step;else handled=false;}else{const item=items.find(i=>i.id===e.containerId);if(!item){handled=false;}else{const span=(e.side==="top"||e.side==="bottom")?item.width:item.length;if(evt.key==="ArrowLeft"||evt.key==="ArrowUp")e.offset=clamp(e.offset-step,e.width/2+.08,span-e.width/2-.08);else if(evt.key==="ArrowRight"||evt.key==="ArrowDown")e.offset=clamp(e.offset+step,e.width/2+.08,span-e.width/2-.08);else handled=false;}}} else handled=false; if(handled){evt.preventDefault();render();} });

  function planBounds(){
    const bs=items.map(containerBounds);
    for(const e of elements.filter(e=>e.type==="stair")){
      const swapped=((e.rot||0)%180)!==0, w=swapped?e.length:e.width, h=swapped?e.width:e.length;
      bs.push({minX:e.x-w/2,maxX:e.x+w/2,minY:e.y-h/2,maxY:e.y+h/2});
    }
    if(bs.length===0) return {minX:0,minY:0,maxX:worldW,maxY:worldH};
    return {
      minX:Math.min(...bs.map(b=>b.minX)), minY:Math.min(...bs.map(b=>b.minY)),
      maxX:Math.max(...bs.map(b=>b.maxX)), maxY:Math.max(...bs.map(b=>b.maxY))
    };
  }

