<script
  define:vars={{
    baureihen: PLANNER_BAUREIHEN,
    worldW: WORLD_W,
    worldH: WORLD_H,
    sending: status.sending,
    success: status.success,
    error: status.error,
    emptyMsg: status.empty,
  }}
>
  const NS = "http://www.w3.org/2000/svg";
  const JOINT_GAP = 0.015;
  const svg = document.getElementById("planner-svg");
  const itemsLayer = document.getElementById("planner-items");
  const elementsLayer = document.getElementById("planner-elements");
  const overlayLayer = document.getElementById("planner-overlay");
  const rotateBtn = document.getElementById("planner-rotate");
  const deleteBtn = document.getElementById("planner-delete");
  const groupBtn = document.getElementById("planner-group");
  const ungroupBtn = document.getElementById("planner-ungroup");
  const clearBtn = document.getElementById("planner-clear");
  const exportBtn = document.getElementById("planner-export");
  const zoomInBtn = document.getElementById("planner-zoom-in");
  const zoomOutBtn = document.getElementById("planner-zoom-out");
  const zoomResetBtn = document.getElementById("planner-zoom-reset");
  const form = document.getElementById("planner-form");
  const statusEl = form?.querySelector(".planner-form-status");
  const totalModulesEl = document.getElementById("planner-total-modules");
  const totalGrossEl = document.getElementById("planner-total-gross");
  const totalNetEl = document.getElementById("planner-total-net");

  const noSelection = document.getElementById("planner-no-selection");
  const containerProps = document.getElementById("planner-container-properties");
  const elementProps = document.getElementById("planner-element-properties");
  const selectedProduct = document.getElementById("planner-selected-product");
  const selectedSize = document.getElementById("planner-selected-size");
  const outerWall = document.getElementById("planner-outer-wall");
  const innerWall = document.getElementById("planner-inner-wall");
  const grossAreaEl = document.getElementById("planner-gross-area");
  const netAreaEl = document.getElementById("planner-net-area");
  const copyOpeningsBtn = document.getElementById("planner-copy-openings");
  const copyModuleBtn = document.getElementById("planner-copy-module");
  const pasteModuleBtn = document.getElementById("planner-paste-module");
  const rowCountInput = document.getElementById("planner-row-count");
  const createRowBtn = document.getElementById("planner-create-row");
  const elementWidth = document.getElementById("planner-element-width");
  const elementWidthValue = document.getElementById("planner-element-width-value");
  const wallThicknessWrap = document.getElementById("planner-wall-thickness-wrap");
  const wallThickness = document.getElementById("planner-wall-thickness");
  const doorOptions = document.getElementById("planner-door-options");
  const doorSwing = document.getElementById("planner-door-swing");
  const doorHinge = document.getElementById("planner-door-hinge");
  const windowOptions = document.getElementById("planner-window-options");
  const windowType = document.getElementById("planner-window-type");
  const windowShutter = document.getElementById("planner-window-shutter");
  const storeysSelect = document.getElementById("planner-storeys");
  const groupNameWrap = document.getElementById("planner-group-name-wrap");
  const groupNameInput = document.getElementById("planner-group-name");
  const stairOptions = document.getElementById("planner-stair-options");
  const stairWidth = document.getElementById("planner-stair-width");
  const stairLength = document.getElementById("planner-stair-length");

  const baureiheById = Object.fromEntries(baureihen.map((b) => [b.id, b]));
  function typesOf(baureiheId) { return baureiheById[baureiheId]?.categories.flatMap((c) => c.types) ?? []; }
  function typeByCode(baureiheId, code) { return typesOf(baureiheId).find((t) => t.code === code); }
  function populateSizeOptions(baureiheId, selectedCode) {
    const b = baureiheById[baureiheId]; if (!b || !selectedSize) return;
    const hasCode = selectedCode != null && typeByCode(baureiheId, selectedCode);
    selectedSize.innerHTML = "";
    for (const cat of b.categories) {
      const group = document.createElement("optgroup"); group.label = cat.label;
      for (const t of cat.types) {
        const opt = document.createElement("option");
        opt.value = t.code; opt.textContent = `${t.name} — ${t.code} (${t.width}×${t.length} m)`;
        group.appendChild(opt);
      }
      selectedSize.appendChild(group);
    }
    selectedSize.value = hasCode ? selectedCode : (typesOf(baureiheId)[0]?.code ?? "");
  }

  let items = [];
  let elements = [];
  let nextId = 1;
  let selected = null; // primary selection: {kind:'container'|'element', id}
  let selectedContainerIds = new Set();
  let selectedElementIds = new Set(); // supports Shift + click multi-select of doors/windows/walls for batch right-click edits
  let nextGroupId = 1;
  const groupNames = new Map();
  let projectOuterWallMm = Number(outerWall?.value || 100);
  let projectInnerWallMm = Number(innerWall?.value || 100);
  let moduleClipboard = null;
  let drag = null;
  let activeTool = "select";
  let wallStart = null;
  let spaceDown = false;
  let pan = null;
  let storeys = Number(storeysSelect?.value) || 1;
  let view = { x: 0, y: 0, w: worldW, h: worldH };

  function clamp(value, min, max) { return Math.min(Math.max(value, min), max); }
  function snap(v, step = 0.1) { return Math.round(v / step) * step; }
  function svgEl(name, attrs = {}) {
    const el = document.createElementNS(NS, name);
    Object.entries(attrs).forEach(([k, v]) => el.setAttribute(k, String(v)));
    return el;
  }
  function applyView() {
    svg.setAttribute("viewBox", `${view.x} ${view.y} ${view.w} ${view.h}`);
    zoomResetBtn.textContent = `${Math.round((worldW / view.w) * 100)}%`;
  }
  function svgPoint(evt) {
    const pt = svg.createSVGPoint(); pt.x = evt.clientX; pt.y = evt.clientY;
    const ctm = svg.getScreenCTM();
    if (!ctm) return { x: 0, y: 0 };
    const p = pt.matrixTransform(ctm.inverse()); return { x: p.x, y: p.y };
  }
  function footprint(item) {
    const swapped = item.rot === 90 || item.rot === 270;
    return { w: swapped ? item.length : item.width, h: swapped ? item.width : item.length };
  }
  function selectedContainer() { return selected?.kind === "container" ? items.find(i => i.id === selected.id) : null; }
  function selectedElement() { return selected?.kind === "element" ? elements.find(i => i.id === selected.id) : null; }
  function selectedContainers() { return items.filter(i => selectedContainerIds.has(i.id)); }
  function setSingleContainerSelection(id) { selectedContainerIds = new Set([id]); selectedElementIds.clear(); selected = {kind:"container", id}; }
  function setSingleElementSelection(kind, id) { selectedContainerIds.clear(); selectedElementIds = new Set([id]); selected = {kind, id}; }
  function clearSelection() { selected = null; selectedContainerIds.clear(); selectedElementIds.clear(); }
  // Elements the right-click should act on: the whole multi-selection if the
  // clicked element is part of one and every member shares its type, otherwise just itself.
  function elementsForContextAction(id) {
    const clicked = elements.find(e => e.id === id);
    if (!clicked) return [];
    if (selectedElementIds.has(id) && selectedElementIds.size > 1) {
      const group = elements.filter(e => selectedElementIds.has(e.id));
      if (group.every(e => e.type === clicked.type)) return group;
    }
    return [clicked];
  }

  function rotateLocalPoint(x, y, item) {
    const cx = item.width / 2, cy = item.length / 2;
    const r = item.rot * Math.PI / 180;
    const dx = x - cx, dy = y - cy;
    return {
      x: item.x + cx + dx * Math.cos(r) - dy * Math.sin(r),
      y: item.y + cy + dx * Math.sin(r) + dy * Math.cos(r)
    };
  }

  function worldToLocalPoint(x, y, item) {
    const cx = item.width / 2, cy = item.length / 2;
    const dx = x - (item.x + cx), dy = y - (item.y + cy);
    const r = -item.rot * Math.PI / 180;
    return {
      x: cx + dx * Math.cos(r) - dy * Math.sin(r),
      y: cy + dx * Math.sin(r) + dy * Math.cos(r)
    };
  }

  function openingPose(e) {
    const item = items.find(i => i.id === e.containerId);
    if (!item) return null;
    const side = e.side;
    const t = sideWallThickness(item, side) || item.outerWallMm/1000;
    let lx = 0, ly = 0, localRot = 0, interiorSign = 1;
    if (side === "top") { lx = e.offset; ly = t/2; localRot = 0; interiorSign = 1; }
    else if (side === "bottom") { lx = e.offset; ly = item.length-t/2; localRot = 0; interiorSign = -1; }
    else if (side === "left") { lx = t/2; ly = e.offset; localRot = 90; interiorSign = -1; }
    else { lx = item.width-t/2; ly = e.offset; localRot = 90; interiorSign = 1; }
    const p = rotateLocalPoint(lx, ly, item);
    return { x:p.x, y:p.y, rot:(item.rot+localRot)%360, item, interiorSign, wallThickness:t };
  }

  function nearestContainerWall(point, item, openingWidth = 0.9) {
    const p = worldToLocalPoint(point.x, point.y, item);
    const candidates = [
      { side: "top", dist: Math.abs(p.y), offset: p.x, span: item.width },
      { side: "bottom", dist: Math.abs(p.y - item.length), offset: p.x, span: item.width },
      { side: "left", dist: Math.abs(p.x), offset: p.y, span: item.length },
      { side: "right", dist: Math.abs(p.x - item.width), offset: p.y, span: item.length },
    ].sort((a,b) => a.dist - b.dist);
    const c = candidates[0];
    const half = openingWidth / 2 + 0.08;
    c.offset = clamp(c.offset, half, Math.max(half, c.span - half));
    return c;
  }

  function addOpeningToContainer(item, type, point) {
    const width = type === "door" ? 0.9 : 1.2;
    const wall = nearestContainerWall(point, item, width);
    const e = { id: nextId++, type, containerId: item.id, side: wall.side, offset: snap(wall.offset, 0.05), width,
      ...(type === "door" ? { swing:"inside", hinge:"left" } : { windowType:"single", shutter:"none" })
    };
    elements.push(e);
    selected = { kind: "element", id: e.id };
    render();
  }

  function containerBounds(item) {
    const pts = [
      rotateLocalPoint(0,0,item), rotateLocalPoint(item.width,0,item),
      rotateLocalPoint(item.width,item.length,item), rotateLocalPoint(0,item.length,item)
    ];
    return {
      minX: Math.min(...pts.map(p=>p.x)), maxX: Math.max(...pts.map(p=>p.x)),
      minY: Math.min(...pts.map(p=>p.y)), maxY: Math.max(...pts.map(p=>p.y))
    };
  }

  const BUILD_JOINT = 0.015; // 15 mm installation/build tolerance between snapped modules
  const SNAP_MAGNET = 0.28;  // user-friendly magnetic capture distance

  function overlapAmount(a1,a2,b1,b2){ return Math.min(a2,b2)-Math.max(a1,b1); }

  function adjacencyBetween(a,b){
    const A=containerBounds(a), B=containerBounds(b);
    const verticalOverlap=overlapAmount(A.minY,A.maxY,B.minY,B.maxY);
    const horizontalOverlap=overlapAmount(A.minX,A.maxX,B.minX,B.maxX);
    const eps=0.035;
    const minVerticalSide=Math.min(A.maxY-A.minY,B.maxY-B.minY);
    const minHorizontalSide=Math.min(A.maxX-A.minX,B.maxX-B.minX);
    if(verticalOverlap>=minVerticalSide-0.04){
      const gapAB=B.minX-A.maxX, gapBA=A.minX-B.maxX;
      if(Math.abs(gapAB-BUILD_JOINT)<=eps) return {aSide:"right",bSide:"left",overlap:verticalOverlap};
      if(Math.abs(gapBA-BUILD_JOINT)<=eps) return {aSide:"left",bSide:"right",overlap:verticalOverlap};
    }
    if(horizontalOverlap>=minHorizontalSide-0.04){
      const gapAB=B.minY-A.maxY, gapBA=A.minY-B.maxY;
      if(Math.abs(gapAB-BUILD_JOINT)<=eps) return {aSide:"bottom",bSide:"top",overlap:horizontalOverlap};
      if(Math.abs(gapBA-BUILD_JOINT)<=eps) return {aSide:"top",bSide:"bottom",overlap:horizontalOverlap};
    }
    return null;
  }

  function allAdjacencies(){
    const result=[];
    for(let i=0;i<items.length;i++) for(let j=i+1;j<items.length;j++){
      const relation=adjacencyBetween(items[i],items[j]);
      if(relation) result.push({a:items[i],b:items[j],...relation});
    }
    return result;
  }

  function adjacentModuleAtOpening(e) {
    const item = items.find(i => i.id === e.containerId);
    if (!item) return null;
    for (const other of items) {
      if (other.id === item.id) continue;
      const ad = adjacencyBetween(item, other);
      if (!ad || ad.aSide !== e.side) continue;
      // adjacencyBetween(item, other) reports the side on item as aSide.
      // Check that the opening lies inside the shared side span.
      const ib = containerBounds(item), ob = containerBounds(other);
      if (e.side === "top" || e.side === "bottom") {
        const worldP = rotateLocalPoint(e.offset, e.side === "top" ? 0 : item.length, item);
        const minX = Math.max(ib.minX, ob.minX) - 0.03, maxX = Math.min(ib.maxX, ob.maxX) + 0.03;
        if (worldP.x >= minX && worldP.x <= maxX) return { item: other, side: ad.bSide };
      } else {
        const worldP = rotateLocalPoint(e.side === "left" ? 0 : item.width, e.offset, item);
        const minY = Math.max(ib.minY, ob.minY) - 0.03, maxY = Math.min(ib.maxY, ob.maxY) + 0.03;
        if (worldP.y >= minY && worldP.y <= maxY) return { item: other, side: ad.bSide };
      }
    }
    return null;
  }

  function openingClearance(e, pose) {
    const neighbor = adjacentModuleAtOpening(e);
    if (!neighbor) {
      return { depth: pose.wallThickness + 0.035, centerY: 0 };
    }
    const neighborT = sideWallThickness(neighbor.item, neighbor.side) || neighbor.item.outerWallMm / 1000;
    const outsideSign = -pose.interiorSign;
    const depth = pose.wallThickness + BUILD_JOINT + neighborT + 0.04;
    // The opening coordinate sits at the centerline of the source panel. Shift the
    // white cut-out toward the neighboring module so both sandwich panels and the
    // 15 mm construction joint are actually opened.
    const centerY = outsideSign * (BUILD_JOINT + neighborT) / 2;
    return { depth, centerY, neighbor, neighborT };
  }

  function snapItemToNeighbors(item){
    if(item.rot%90!==0) return;
    let b=containerBounds(item);
    let bestX=null,bestY=null;
    for(const other of items){
      if(other.id===item.id) continue;
      if(item.groupId && other.groupId===item.groupId) continue;
      const O=containerBounds(other);
      const vOverlap=overlapAmount(b.minY,b.maxY,O.minY,O.maxY);
      const hOverlap=overlapAmount(b.minX,b.maxX,O.minX,O.maxX);
      const xCandidates=[
        {delta:(O.maxX+BUILD_JOINT)-b.minX, score:Math.abs((O.maxX+BUILD_JOINT)-b.minX)},
        {delta:(O.minX-BUILD_JOINT)-b.maxX, score:Math.abs((O.minX-BUILD_JOINT)-b.maxX)}
      ];
      const yCandidates=[
        {delta:(O.maxY+BUILD_JOINT)-b.minY, score:Math.abs((O.maxY+BUILD_JOINT)-b.minY)},
        {delta:(O.minY-BUILD_JOINT)-b.maxY, score:Math.abs((O.minY-BUILD_JOINT)-b.maxY)}
      ];
      if(vOverlap>-0.05) for(const c of xCandidates) if(c.score<=SNAP_MAGNET && (!bestX||c.score<bestX.score)) bestX=c;
      if(hOverlap>-0.05) for(const c of yCandidates) if(c.score<=SNAP_MAGNET && (!bestY||c.score<bestY.score)) bestY=c;
      // also align parallel edges/centers so rows and columns feel magnetic
      const alignX=[O.minX-b.minX,O.maxX-b.maxX,((O.minX+O.maxX)-(b.minX+b.maxX))/2];
      const alignY=[O.minY-b.minY,O.maxY-b.maxY,((O.minY+O.maxY)-(b.minY+b.maxY))/2];
      for(const d of alignX) if(Math.abs(d)<=0.08 && (!bestX||Math.abs(d)<bestX.score)) bestX={delta:d,score:Math.abs(d)};
      for(const d of alignY) if(Math.abs(d)<=0.08 && (!bestY||Math.abs(d)<bestY.score)) bestY={delta:d,score:Math.abs(d)};
    }
    if(bestX) item.x += bestX.delta;
    if(bestY) item.y += bestY.delta;
  }

  function sideWallThickness(item, localSide, adjacencies = allAdjacencies()) {
    const shared = adjacencies.find(a =>
      (a.a.id===item.id && worldSideToLocal(item,a.aSide)===localSide) ||
      (a.b.id===item.id && worldSideToLocal(item,a.bSide)===localSide)
    );
    if (!shared) return item.outerWallMm / 1000;
    const other = shared.a.id===item.id ? shared.b : shared.a;
    if (item.groupId && other.groupId===item.groupId) return 0;
    return item.innerWallMm / 1000;
  }

  function netArea(item, adjacencies = allAdjacencies()){
    const left=sideWallThickness(item,"left",adjacencies), right=sideWallThickness(item,"right",adjacencies);
    const top=sideWallThickness(item,"top",adjacencies), bottom=sideWallThickness(item,"bottom",adjacencies);
    return Math.max(0,item.width-left-right)*Math.max(0,item.length-top-bottom);
  }

  function groupNetArea(groupId, adjacencies = allAdjacencies()){
    const members=items.filter(i=>i.groupId===groupId);
    let area=members.reduce((sum,i)=>sum+netArea(i,adjacencies),0);
    for(const a of adjacencies){
      if(a.a.groupId===groupId && a.b.groupId===groupId){
        area += a.overlap * BUILD_JOINT;
      }
    }
    return area;
  }

  function groupBounds(groupId){
    const members=items.filter(i=>i.groupId===groupId);
    const bs=members.map(containerBounds);
    if(!bs.length) return null;
    return {minX:Math.min(...bs.map(b=>b.minX)),minY:Math.min(...bs.map(b=>b.minY)),maxX:Math.max(...bs.map(b=>b.maxX)),maxY:Math.max(...bs.map(b=>b.maxY))};
  }

  function worldSideToLocal(item, side){
    const r=((item.rot%360)+360)%360;
    const maps={
      0:{top:"top",right:"right",bottom:"bottom",left:"left"},
      90:{top:"left",right:"top",bottom:"right",left:"bottom"},
      180:{top:"bottom",right:"left",bottom:"top",left:"right"},
      270:{top:"right",right:"bottom",bottom:"left",left:"top"}
    };
    return (maps[r]||maps[0])[side];
  }

  function currentTotalAreas(){
    const adj=allAdjacencies();
    let gross=0,net=0;
    for(const c of items){ gross += c.width*c.length; net += netArea(c,adj); }
    for(const a of adj){ if(a.a.groupId && a.a.groupId===a.b.groupId) net += a.overlap*BUILD_JOINT; }
    return {gross,net};
  }

  function moduleDisplayNames(){
    const buckets=new Map();
    for(const item of items){
      const key=`${item.label} ${item.size}`;
      if(!buckets.has(key)) buckets.set(key,[]);
      buckets.get(key).push(item);
    }
    const names=new Map();
    for(const [key,list] of buckets){
      list.sort((a,b)=>a.id-b.id);
      list.forEach((item,index)=>names.set(item.id,list.length>1?`${key} ${index+1}`:key));
    }
    return names;
  }

  function openingLabel(e){
    if(e.type==="door") return `T ${e.width.toFixed(2)} m`;
    if(e.type==="window") return `F ${e.width.toFixed(2)} m`;
    return "";
  }

  function groupRoomName(groupId){ return groupNames.get(groupId) || `Raumgruppe ${groupId}`; }

  function renderProperties() {
    const c = selectedContainer(); const e = selectedElement();
    const multiCount = selectedContainerIds.size;
    const multiElementCount = selectedElementIds.size;
    noSelection.classList.toggle("hidden", !(multiCount>1 || multiElementCount>1 || (!selected && multiCount===0 && multiElementCount===0)));
    if(multiCount>1) noSelection.textContent=`${multiCount} Module ausgewählt · „Gruppieren“ entfernt gemeinsame Zwischenwände und bewegt die Module anschließend als Einheit.`;
    else if(multiElementCount>1) noSelection.textContent=`${multiElementCount} Bauteile ausgewählt · Rechtsklick ändert die Ausführung für alle gemeinsam (nur bei gleicher Art wirksam).`;
    else if(!selected) noSelection.textContent="Noch nichts ausgewählt.";
    containerProps.classList.toggle("hidden", !c || multiCount>1);
    elementProps.classList.toggle("hidden", !e || multiElementCount>1);
    if (c) {
      selectedProduct.value = c.productId; populateSizeOptions(c.productId, c.size);
      const gross = c.width * c.length;
      grossAreaEl.textContent = `${gross.toFixed(2)} m²`;
      netAreaEl.textContent = c.groupId ? `${groupNetArea(c.groupId).toFixed(2)} m² (Gruppe)` : `${netArea(c).toFixed(2)} m²`;
      groupNameWrap.classList.toggle("hidden", !c.groupId);
      if(c.groupId) groupNameInput.value=groupNames.get(c.groupId)||"";
    } else { groupNameWrap.classList.add("hidden"); }
    doorOptions.classList.toggle("hidden", e?.type !== "door");
    windowOptions.classList.toggle("hidden", e?.type !== "window");
    stairOptions.classList.toggle("hidden", e?.type !== "stair");
    if (e) {
      wallThicknessWrap.classList.toggle("hidden", e.type !== "wall");
      elementWidth.parentElement.parentElement.classList.toggle("hidden", e.type === "wall");
      if (e.type === "wall") { wallThickness.value = String(e.thicknessMm); }
      else if(e.type==="stair"){
        elementWidth.parentElement.parentElement.classList.add("hidden");
        stairWidth.value=String(e.width||1.2); stairLength.value=String(e.length||3.0);
      } else {
        elementWidth.value = e.width; elementWidthValue.textContent = `${e.width.toFixed(1)} m`;
        if(e.type==="door"){ doorSwing.value=e.swing||"inside"; doorHinge.value=e.hinge||"left"; }
        if(e.type==="window"){ windowType.value=e.windowType||"single"; windowShutter.value=e.shutter||"none"; }
      }
    }
  }

  function addDimension(layer, x1, y1, x2, y2, label, offset = 0.35) {
    const horizontal = Math.abs(y2-y1) < Math.abs(x2-x1);
    const ox = horizontal ? 0 : offset; const oy = horizontal ? offset : 0;
    const l = svgEl("line", { x1:x1+ox, y1:y1+oy, x2:x2+ox, y2:y2+oy, stroke:"#5f666b", "stroke-width":"0.025", "marker-start":"url(#dim-arrow)", "marker-end":"url(#dim-arrow)" });
    layer.appendChild(l);
    const t = svgEl("text", { x:(x1+x2)/2+ox, y:(y1+y2)/2+oy-0.08, "text-anchor":"middle", "font-size":"0.22", fill:"#5f666b", "paint-order":"stroke", stroke:"white", "stroke-width":"0.08" });
    t.textContent = label; layer.appendChild(t);
  }

  function render() {
    itemsLayer.innerHTML = ""; elementsLayer.innerHTML = ""; overlayLayer.innerHTML = "";
    const totalA=currentTotalAreas();
    totalModulesEl.textContent=String(items.length);
    totalGrossEl.textContent=`${totalA.gross.toFixed(2)} m²`;
    totalNetEl.textContent=`${totalA.net.toFixed(2)} m²`;
    const adj=allAdjacencies();
    const displayNames=moduleDisplayNames();

    for (const item of items) {
      const g = svgEl("g", { "data-kind":"container", "data-id":item.id, class:"planner-object", transform:`translate(${item.x} ${item.y}) rotate(${item.rot} ${item.width/2} ${item.length/2})` });
      g.style.cursor = activeTool === "select" ? "grab" : "crosshair";
      const selectedNow = selectedContainerIds.has(item.id);
      g.appendChild(svgEl("rect", { width:item.width, height:item.length, fill:"#fff", stroke:"none" }));

      // Every module keeps its own sandwich panel. Adjacent, ungrouped modules therefore show
      // two separate panels with the real 15 mm installation gap in between.
      const shared={};
      for(const a of adj){
        if(a.a.id===item.id) shared[worldSideToLocal(item,a.aSide)]={other:a.b, relation:a};
        if(a.b.id===item.id) shared[worldSideToLocal(item,a.bSide)]={other:a.a, relation:a};
      }
      const wallFill=selectedNow?"#c84a2f":"#15181b";
      for(const side of ["top","right","bottom","left"]){
        const sh=shared[side];
        if(sh && item.groupId && sh.other.groupId===item.groupId) continue;
        const t=(sh?item.innerWallMm:item.outerWallMm)/1000;
        if(side==="top") g.appendChild(svgEl("rect",{x:0,y:0,width:item.width,height:t,fill:wallFill}));
        else if(side==="bottom") g.appendChild(svgEl("rect",{x:0,y:item.length-t,width:item.width,height:t,fill:wallFill}));
        else if(side==="left") g.appendChild(svgEl("rect",{x:0,y:0,width:t,height:item.length,fill:wallFill}));
        else g.appendChild(svgEl("rect",{x:item.width-t,y:0,width:t,height:item.length,fill:wallFill}));
      }

      if(!item.groupId){
        const text = svgEl("text", { x:item.width/2, y:item.length/2-0.10, "text-anchor":"middle", "dominant-baseline":"middle", "font-size":"0.28", fill:"#15181b", transform:`rotate(${-item.rot} ${item.width/2} ${item.length/2})` });
        text.textContent = displayNames.get(item.id); g.appendChild(text);
        const areaText=svgEl("text",{x:item.width/2,y:item.length/2+0.26,"text-anchor":"middle","dominant-baseline":"middle","font-size":"0.20",fill:"#5f666b",transform:`rotate(${-item.rot} ${item.width/2} ${item.length/2})`});
        areaText.textContent=`${netArea(item,adj).toFixed(2)} m² netto`; g.appendChild(areaText);
      } else {
        const moduleId=svgEl("text",{x:item.width-0.16,y:0.30,"text-anchor":"end","font-size":"0.14",fill:"#5f666b",transform:`rotate(${-item.rot} ${item.width/2} ${item.length/2})`});
        moduleId.textContent=displayNames.get(item.id); g.appendChild(moduleId);
      }
      const panelText=svgEl("text",{x:0.18,y:0.30,"font-size":"0.14",fill:"#5f666b",transform:`rotate(${-item.rot} ${item.width/2} ${item.length/2})`});
      panelText.textContent=`AW ${item.outerWallMm} / TW ${item.innerWallMm} mm`; g.appendChild(panelText);
      itemsLayer.appendChild(g);

      if (selectedNow && selectedContainerIds.size===1) {
        const fp = footprint(item);
        addDimension(overlayLayer, item.x, item.y-0.12, item.x+fp.w, item.y-0.12, `${fp.w.toFixed(3)} m`, -0.28);
        addDimension(overlayLayer, item.x-0.12, item.y, item.x-0.12, item.y+fp.h, `${fp.h.toFixed(3)} m`, -0.28);
      }
    }

    const renderedGroups=new Set();
    for(const item of items){
      if(!item.groupId || renderedGroups.has(item.groupId)) continue;
      renderedGroups.add(item.groupId);
      const gb=groupBounds(item.groupId); if(!gb) continue;
      const gx=(gb.minX+gb.maxX)/2, gy=(gb.minY+gb.maxY)/2;
      const gt=svgEl("text",{x:gx,y:gy-0.10,"text-anchor":"middle","font-size":"0.30",fill:"#15181b","font-weight":"600","paint-order":"stroke",stroke:"white","stroke-width":"0.10"});
      gt.textContent=groupRoomName(item.groupId); itemsLayer.appendChild(gt);
      const ga=svgEl("text",{x:gx,y:gy+0.25,"text-anchor":"middle","font-size":"0.21",fill:"#5f666b","paint-order":"stroke",stroke:"white","stroke-width":"0.08"});
      ga.textContent=`${groupNetArea(item.groupId,adj).toFixed(2)} m² netto`; itemsLayer.appendChild(ga);
    }

    for (const e of elements) {
      const selectedNow = selectedElementIds.has(e.id);
      if (e.type === "wall") {
        const g = svgEl("g", { "data-kind":"element", "data-id":e.id, class:"planner-object" }); g.style.cursor="pointer";
        g.appendChild(svgEl("line", { x1:e.x1,y1:e.y1,x2:e.x2,y2:e.y2,stroke:selectedNow?"#c84a2f":"#15181b","stroke-width":Math.max(.06,e.thicknessMm/1000),"stroke-linecap":"square" }));
        elementsLayer.appendChild(g);
        if (selectedNow) addDimension(overlayLayer,e.x1,e.y1,e.x2,e.y2,`${Math.hypot(e.x2-e.x1,e.y2-e.y1).toFixed(2)} m`,.25);
      } else if(e.type==="stair") {
        const g=svgEl("g",{"data-kind":"element","data-id":e.id,class:"planner-object",transform:`translate(${e.x} ${e.y}) rotate(${e.rot||0})`}); g.style.cursor="grab";
        g.appendChild(svgEl("rect",{x:-e.width/2,y:-e.length/2,width:e.width,height:e.length,fill:"#fff",stroke:selectedNow?"#c84a2f":"#15181b","stroke-width":".04"}));
        const steps=8; for(let n=1;n<steps;n++){const yy=-e.length/2+n*e.length/steps;g.appendChild(svgEl("line",{x1:-e.width/2,y1:yy,x2:e.width/2,y2:yy,stroke:"#5f666b","stroke-width":".02"}));}
        g.appendChild(svgEl("line",{x1:0,y1:e.length*.30,x2:0,y2:-e.length*.30,stroke:"#15181b","stroke-width":".035","marker-end":"url(#dim-arrow)"}));
        elementsLayer.appendChild(g);
      } else {
        const pose = openingPose(e); if (!pose) continue;
        const g = svgEl("g", { "data-kind":"element", "data-id":e.id, class:"planner-object", transform:`translate(${pose.x} ${pose.y}) rotate(${pose.rot})` });
        g.style.cursor = activeTool === "select" ? "pointer" : "crosshair";
        if (e.type === "window") {
          const clearance=openingClearance(e,pose);
          const glassHalf=Math.min(.045,Math.max(.018,pose.wallThickness*.25));
          g.appendChild(svgEl("rect",{x:-e.width/2-.03,y:clearance.centerY-clearance.depth/2,width:e.width+.06,height:clearance.depth,fill:"#ffffff",stroke:"none"}));
          g.appendChild(svgEl("line",{x1:-e.width/2,y1:-glassHalf,x2:e.width/2,y2:-glassHalf,stroke:selectedNow?"#c84a2f":"#15181b","stroke-width":".03"}));
          g.appendChild(svgEl("line",{x1:-e.width/2,y1:glassHalf,x2:e.width/2,y2:glassHalf,stroke:selectedNow?"#c84a2f":"#15181b","stroke-width":".03"}));
          g.appendChild(svgEl("line",{x1:-e.width/2,y1:-.1,x2:-e.width/2,y2:.1,stroke:"#15181b","stroke-width":".025"}));
          g.appendChild(svgEl("line",{x1:e.width/2,y1:-.1,x2:e.width/2,y2:.1,stroke:"#15181b","stroke-width":".025"}));
          if((e.windowType||"single")==="double") g.appendChild(svgEl("line",{x1:0,y1:-.11,x2:0,y2:.11,stroke:"#15181b","stroke-width":".025"}));
          if((e.shutter||"none")==="roller"){
            const sy=-pose.interiorSign*.16;
            g.appendChild(svgEl("line",{x1:-e.width/2,y1:sy,x2:e.width/2,y2:sy,stroke:"#5f666b","stroke-width":".04"}));
            for(let x=-e.width/2+.12;x<e.width/2;x+=.18) g.appendChild(svgEl("line",{x1:x,y1:sy-.035,x2:x,y2:sy+.035,stroke:"#5f666b","stroke-width":".018"}));
          }
        } else {
          const clearance=openingClearance(e,pose);
          g.appendChild(svgEl("rect",{x:-e.width/2-.03,y:clearance.centerY-clearance.depth/2,width:e.width+.06,height:clearance.depth,fill:"#ffffff",stroke:"none"}));
          const hinge=(e.hinge||"left")==="left"?-e.width/2:e.width/2;
          const closed=(e.hinge||"left")==="left"?e.width/2:-e.width/2;
          const dir=(e.swing||"inside")==="inside"?pose.interiorSign:-pose.interiorSign;
          const openX=hinge, openY=dir*e.width;
          g.appendChild(svgEl("line",{x1:hinge,y1:0,x2:openX,y2:openY,stroke:selectedNow?"#c84a2f":"#15181b","stroke-width":".035"}));
          const sweep=((e.hinge||"left")==="left") === (dir>0) ? 1 : 0;
          g.appendChild(svgEl("path",{d:`M ${closed} 0 A ${e.width} ${e.width} 0 0 ${sweep} ${openX} ${openY}`,fill:"none",stroke:"#5f666b","stroke-width":".025"}));
          g.appendChild(svgEl("circle",{cx:hinge,cy:0,r:.035,fill:"#15181b"}));
        }
        const tag=svgEl("text",{x:0,y:pose.interiorSign*(pose.wallThickness/2+.22),"text-anchor":"middle","font-size":"0.15",fill:"#5f666b","paint-order":"stroke",stroke:"white","stroke-width":"0.07"});
        tag.textContent=openingLabel(e); g.appendChild(tag);
        elementsLayer.appendChild(g);
      }
    }
    if (wallStart) overlayLayer.appendChild(svgEl("circle",{cx:wallStart.x,cy:wallStart.y,r:.12,fill:"#c84a2f"}));
    rotateBtn.disabled = !(selectedContainerIds.size===1 || selectedElement()?.type==="stair");
    deleteBtn.disabled = !selected && selectedContainerIds.size===0;
    groupBtn.disabled = selectedContainerIds.size<2;
    ungroupBtn.disabled = !selectedContainers().some(i=>i.groupId);
    renderProperties();
  }

  function addItemAt(productId, label, sizeCode, worldX, worldY) {
    const size = typeByCode(productId, sizeCode); if (!size) return;
    const item={id:nextId++,productId,label,size:sizeCode,width:size.width,length:size.length,
      x:clamp(worldX-size.width/2,0,worldW-size.width), y:clamp(worldY-size.length/2,0,worldH-size.length),
      rot:0,outerWallMm:projectOuterWallMm,innerWallMm:projectInnerWallMm,groupId:null};
    items.push(item); setSingleContainerSelection(item.id); snapItemToNeighbors(item); activeTool="select"; updateToolButtons(); render();
    return item;
  }

  let addCount = 0;
  function addItem(productId, label, sizeCode) {
    const size = typeByCode(productId, sizeCode); if (!size) return;
    addCount += 1;
    const spawnX = clamp(.5+((addCount-1)%6)*.4, 0, worldW-size.width);
    const spawnY = clamp(.5+((addCount-1)%6)*.4, 0, worldH-size.length);
    addItemAt(productId, label, sizeCode, spawnX+size.width/2, spawnY+size.length/2);
  }
  document.querySelectorAll(".planner-add-btn").forEach(btn=>btn.addEventListener("click",()=>{
    const productId=btn.getAttribute("data-product"); const label=btn.getAttribute("data-label");
    const selectEl=document.querySelector(`.planner-size-select[data-product="${productId}"]`);
    addItem(productId,label,selectEl?selectEl.value:typesOf(productId)[0]?.code);
  }));

  function updateToolButtons(){ document.querySelectorAll(".planner-tool").forEach(b=>b.classList.toggle("bg-mist",b.getAttribute("data-tool")===activeTool)); }

  // Right-click context menus for doors/windows/partitions/stairs: right-click
  // empty canvas to switch tool, right-click a placed container/element to act
  // on it (or, with several same-type elements Shift-selected, on all of them).
  const menuEmpty = document.getElementById("planner-menu-empty");
  const menuContainer = document.getElementById("planner-menu-container");
  const menuWindow = document.getElementById("planner-menu-window");
  const menuDoor = document.getElementById("planner-menu-door");
  const menuWall = document.getElementById("planner-menu-wall");
  const menuStair = document.getElementById("planner-menu-stair");
  const allMenus = [menuEmpty, menuContainer, menuWindow, menuDoor, menuWall, menuStair].filter(Boolean);
  const elementMenuByType = { window: menuWindow, door: menuDoor, wall: menuWall, stair: menuStair };
  let contextElementId = null;

  function hideMenus(){ allMenus.forEach(m=>m.classList.add("hidden")); contextElementId = null; }

  function showMenu(menu, clientX, clientY){
    hideMenus();
    menu.classList.remove("hidden");
    const rect = menu.getBoundingClientRect();
    const vw = window.innerWidth, vh = window.innerHeight;
    let left = clientX, top = clientY;
    if (left + rect.width > vw - 8) left = Math.max(8, vw - rect.width - 8);
    if (top + rect.height > vh - 8) top = Math.max(8, vh - rect.height - 8);
    menu.style.left = `${left}px`;
    menu.style.top = `${top}px`;
  }

  svg.addEventListener("contextmenu", evt => {
    evt.preventDefault();
    const target = evt.target.closest?.(".planner-object");
    if (!target) {
      clearSelection(); render();
      showMenu(menuEmpty, evt.clientX, evt.clientY);
      return;
    }
    const kind = target.getAttribute("data-kind"), id = Number(target.getAttribute("data-id"));
    if (kind === "container") {
      setSingleContainerSelection(id); render();
      showMenu(menuContainer, evt.clientX, evt.clientY);
      return;
    }
    const el = elements.find(x => x.id === id);
    if (!el) return;
    // Keep an existing same-type multi-selection intact; otherwise select just this one.
    if (!(selectedElementIds.has(id) && selectedElementIds.size > 1)) setSingleElementSelection(kind, id);
    render();
    const menu = elementMenuByType[el.type];
    if (!menu) return;
    const countLabel = document.getElementById(`planner-menu-${el.type}-count`);
    const targets = elementsForContextAction(id);
    if (countLabel) countLabel.classList.toggle("hidden", targets.length <= 1);
    if (countLabel && targets.length > 1) countLabel.textContent = `${targets.length} ausgewählt — Änderung gilt für alle`;
    showMenu(menu, evt.clientX, evt.clientY);
    contextElementId = id;
  });

  document.querySelectorAll(".planner-ctx-tool").forEach(btn => btn.addEventListener("click", () => {
    activeTool = btn.dataset.tool; wallStart = null; clearSelection(); updateToolButtons(); render();
    hideMenus();
  }));
  document.getElementById("planner-ctx-rotate")?.addEventListener("click", () => { rotateBtn?.click(); hideMenus(); });
  document.getElementById("planner-ctx-group")?.addEventListener("click", () => { groupBtn?.click(); hideMenus(); });
  document.getElementById("planner-ctx-ungroup")?.addEventListener("click", () => { ungroupBtn?.click(); hideMenus(); });
  document.getElementById("planner-ctx-delete")?.addEventListener("click", () => { deleteBtn?.click(); hideMenus(); });

  function applyToContextElements(mutate){
    if (contextElementId == null) return;
    for (const el of elementsForContextAction(contextElementId)) mutate(el);
    render(); hideMenus();
  }
  document.querySelectorAll(".planner-ctx-window-type").forEach(btn => btn.addEventListener("click", () => applyToContextElements(e => { e.windowType = btn.dataset.value; })));
  document.querySelectorAll(".planner-ctx-window-shutter").forEach(btn => btn.addEventListener("click", () => applyToContextElements(e => { e.shutter = btn.dataset.value; })));
  document.querySelectorAll(".planner-ctx-window-width").forEach(btn => btn.addEventListener("click", () => applyToContextElements(e => {
    e.width = Number(btn.dataset.value);
    const item = items.find(i => i.id === e.containerId);
    if (item) { const span = (e.side==="top"||e.side==="bottom") ? item.width : item.length; const half = e.width/2+.08; e.offset = clamp(e.offset, half, Math.max(half, span-half)); }
  })));
  document.getElementById("planner-ctx-window-delete")?.addEventListener("click", () => { deleteBtn?.click(); hideMenus(); });

  document.querySelectorAll(".planner-ctx-door-swing").forEach(btn => btn.addEventListener("click", () => applyToContextElements(e => { e.swing = btn.dataset.value; })));
  document.querySelectorAll(".planner-ctx-door-hinge").forEach(btn => btn.addEventListener("click", () => applyToContextElements(e => { e.hinge = btn.dataset.value; })));
  document.querySelectorAll(".planner-ctx-door-width").forEach(btn => btn.addEventListener("click", () => applyToContextElements(e => {
    e.width = Number(btn.dataset.value);
    const item = items.find(i => i.id === e.containerId);
    if (item) { const span = (e.side==="top"||e.side==="bottom") ? item.width : item.length; const half = e.width/2+.08; e.offset = clamp(e.offset, half, Math.max(half, span-half)); }
  })));
  document.getElementById("planner-ctx-door-delete")?.addEventListener("click", () => { deleteBtn?.click(); hideMenus(); });

  document.querySelectorAll(".planner-ctx-wall-thickness").forEach(btn => btn.addEventListener("click", () => applyToContextElements(e => { e.thicknessMm = Number(btn.dataset.value); })));
  document.getElementById("planner-ctx-wall-delete")?.addEventListener("click", () => { deleteBtn?.click(); hideMenus(); });

  document.getElementById("planner-ctx-stair-rotate")?.addEventListener("click", () => applyToContextElements(e => { e.rot = ((e.rot||0)+90)%360; }));
  document.getElementById("planner-ctx-stair-delete")?.addEventListener("click", () => { deleteBtn?.click(); hideMenus(); });

