  function buildExportSvg(){
    const clone=svg.cloneNode(true);
    const ov=clone.querySelector("#planner-overlay"); if(ov)ov.innerHTML="";
    const grid=clone.querySelector("#planner-grid-bg"); if(grid)grid.remove();
    // PDF must never inherit editor selection highlighting.
    clone.querySelectorAll('[fill="#c84a2f"]').forEach(n=>n.setAttribute("fill","#15181b"));
    clone.querySelectorAll('[stroke="#c84a2f"]').forEach(n=>n.setAttribute("stroke","#15181b"));

    const b=planBounds();
    const overallW=b.maxX-b.minX, overallH=b.maxY-b.minY;
    const marginX=1.65, marginTop=1.45, marginBottom=1.25;
    const exportBox={x:b.minX-marginX,y:b.minY-marginTop,w:overallW+2*marginX,h:overallH+marginTop+marginBottom};
    clone.setAttribute("viewBox",`${exportBox.x} ${exportBox.y} ${exportBox.w} ${exportBox.h}`);
    const temp=document.createElementNS(NS,"g"); temp.setAttribute("id","export-dimensions"); clone.appendChild(temp);

    // Extension lines + overall dimensions placed clearly outside the building.
    const extStroke="#8a9196";
    for(const x of [b.minX,b.maxX]) temp.appendChild(svgEl("line",{x1:x,y1:b.minY-.05,x2:x,y2:b.minY-.82,stroke:extStroke,"stroke-width":".018"}));
    for(const y of [b.minY,b.maxY]) temp.appendChild(svgEl("line",{x1:b.minX-.05,y1:y,x2:b.minX-.82,y2:y,stroke:extStroke,"stroke-width":".018"}));
    addDimension(temp,b.minX,b.minY-.70,b.maxX,b.minY-.70,`${overallW.toFixed(3)} m`,-.18);
    addDimension(temp,b.minX-.70,b.minY,b.minX-.70,b.maxY,`${overallH.toFixed(3)} m`,-.18);

    // Dimension chains from real module boundaries. Duplicate coordinates are collapsed.
    const xs=[...new Set(items.flatMap(i=>{const q=containerBounds(i);return [q.minX,q.maxX]}).map(v=>v.toFixed(3)))].map(Number).sort((a,b)=>a-b);
    const ys=[...new Set(items.flatMap(i=>{const q=containerBounds(i);return [q.minY,q.maxY]}).map(v=>v.toFixed(3)))].map(Number).sort((a,b)=>a-b);
    const topY=b.minY-.36;
    for(let k=0;k<xs.length-1;k++){ const d=xs[k+1]-xs[k]; if(d>.05) addDimension(temp,xs[k],topY,xs[k+1],topY,`${d.toFixed(3)} m`,0); }
    const leftX=b.minX-.36;
    for(let k=0;k<ys.length-1;k++){ const d=ys[k+1]-ys[k]; if(d>.05) addDimension(temp,leftX,ys[k],leftX,ys[k+1],`${d.toFixed(3)} m`,0); }

    // Explicit paneel legend so wall construction remains readable even on dense plans.
    const legend=svgEl("text",{x:b.minX,y:b.maxY+.56,"font-size":".15",fill:"#5f666b"});
    legend.textContent=`Paneelangaben im Modul: AW = Außenwand · TW = Trennwand · Montagefuge zwischen Modulen = 15 mm · ${storeys} Geschoss${storeys===1?"":"e"}`;
    temp.appendChild(legend);
    return {clone,box:exportBox};
  }

  function svgToPngBlob(exportMode=false){return new Promise((resolve,reject)=>{const built=exportMode?buildExportSvg():null;const source=exportMode?built.clone:svg.cloneNode(true);const vb=exportMode?built.box:{w:worldW,h:worldH};const scale=140;source.setAttribute("width",String(vb.w*scale));source.setAttribute("height",String(vb.h*scale));const data=new XMLSerializer().serializeToString(source);const img=new Image();img.onload=()=>{const canvas=document.createElement("canvas");canvas.width=Math.max(1,Math.round(vb.w*scale));canvas.height=Math.max(1,Math.round(vb.h*scale));const ctx=canvas.getContext("2d");ctx.fillStyle="#fff";ctx.fillRect(0,0,canvas.width,canvas.height);ctx.drawImage(img,0,0,canvas.width,canvas.height);canvas.toBlob(b=>b?resolve(b):reject(new Error("toBlob failed")),"image/png",.95);};img.onerror=reject;img.src="data:image/svg+xml;base64,"+btoa(unescape(encodeURIComponent(data)));});}
  function loadJsPdf(){return new Promise((resolve,reject)=>{if(window.jspdf){resolve(window.jspdf);return;}const s=document.createElement("script");s.src="https://cdn.jsdelivr.net/npm/jspdf@2.5.2/dist/jspdf.umd.min.js";s.onload=()=>resolve(window.jspdf);s.onerror=reject;document.head.appendChild(s);});}
  exportBtn?.addEventListener("click",async()=>{try{const blob=await svgToPngBlob(true);const dataUrl=await new Promise(r=>{const fr=new FileReader();fr.onload=()=>r(fr.result);fr.readAsDataURL(blob);});const lib=await loadJsPdf();const {jsPDF}=lib;const pdf=new jsPDF({orientation:"landscape",unit:"mm",format:"a3"});pdf.setFontSize(14);pdf.text("Grundriss / Floor plan",15,12);pdf.setFontSize(8);pdf.text(`Grundriss · ${storeys} Geschoss${storeys===1?"":"e"} · Außenmaße / Maßketten / Öffnungen / Paneelstärken`,15,17);const pw=pdf.internal.pageSize.getWidth(),ph=pdf.internal.pageSize.getHeight();const imgProps=pdf.getImageProperties(dataUrl);const maxW=pw-24,maxH=ph-34;const ratio=Math.min(maxW/imgProps.width,maxH/imgProps.height);const w=imgProps.width*ratio,h=imgProps.height*ratio;pdf.addImage(dataUrl,"PNG",(pw-w)/2,22+(maxH-h)/2,w,h);pdf.save("grundriss-mit-massen.pdf");}catch(err){console.error(err);alert(`PDF-Export fehlgeschlagen: ${err?.message || err}. Bitte Seite neu laden und erneut versuchen.`);}});

  function summaryText(){if(items.length===0&&elements.length===0)return"";const counts=new Map();for(const item of items){const key=`${item.label} ${item.size}`;counts.set(key,(counts.get(key)||0)+1);}const lines=[...counts.entries()].map(([k,c])=>`${c}× ${k}`);const walls=elements.filter(e=>e.type==="wall").length,doors=elements.filter(e=>e.type==="door").length,windows=elements.filter(e=>e.type==="window").length,stairs=elements.filter(e=>e.type==="stair").length;const a=totalAreas();const groups=[...new Set(items.map(i=>i.groupId).filter(Boolean))].map(g=>`${groupRoomName(g)}: ${groupNetArea(g).toFixed(2)} m² netto`);return `Geschosse: ${storeys}\nPaneele gesamte Anlage: Außenwand ${projectOuterWallMm} mm | Trennwand je Container ${projectInnerWallMm} mm\nContainer im Entwurf:\n`+lines.join("\n")+(groups.length?`\nGruppenräume:\n${groups.join("\n")}`:"")+`\nFlächen: ${a.gross.toFixed(2)} m² brutto / ca. ${a.net.toFixed(2)} m² netto innen\nBauteile: ${walls} Trennwände, ${doors} Türen, ${windows} Fenster, ${stairs} Außentreppen`;}
  form?.addEventListener("submit",async event=>{event.preventDefault();if(!statusEl)return;if(items.length===0){statusEl.classList.remove("hidden","text-steel");statusEl.classList.add("text-signal");statusEl.textContent=emptyMsg;return;}statusEl.classList.remove("hidden","text-signal");statusEl.classList.add("text-steel");statusEl.textContent=sending;try{const blob=await svgToPngBlob(true);const formData=new FormData(form);formData.append("grundriss-zusammenfassung",summaryText());formData.append("grundriss-skizze",new File([blob],"grundriss-entwurf.png",{type:"image/png"}));const response=await fetch(form.action,{method:"POST",body:formData,headers:{Accept:"application/json"}});if(response.ok){statusEl.textContent=success;form.reset();}else{statusEl.classList.add("text-signal");statusEl.textContent=error;}}catch{statusEl.classList.add("text-signal");statusEl.textContent=error;}});
  applyView(); render();
</script>
