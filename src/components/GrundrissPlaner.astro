    }
    if(drag?.kind==="container"){
      const anchor=items.find(x=>x.id===drag.id);
      if(anchor){
        const before={x:anchor.x,y:anchor.y}; snapItemToNeighbors(anchor);
        const dx=anchor.x-before.x,dy=anchor.y-before.y;
