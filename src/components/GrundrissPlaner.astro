    if(!source) return;
    copyModuleBtn.textContent="Kopiert ✓";
    setTimeout(()=>{copyModuleBtn.textContent="Kopieren";},900);
  });

  pasteModuleBtn?.addEventListener("click",()=>{
    if(!moduleClipboard) return;
    const src=moduleClipboard.module;
    const sourceBounds=containerBounds(src);
    const clone={...src,id:nextId++,x:src.x,y:src.y,groupId:null,outerWallMm:projectOuterWallMm,innerWallMm:projectInnerWallMm};
    // Position the real rotated bounding box 15 mm to the right.
    const cloneBounds=containerBounds(clone);
    clone.x += (sourceBounds.maxX + BUILD_JOINT) - cloneBounds.minX;
    items.push(clone);
    for(const e of moduleClipboard.openings) elements.push({...e,id:nextId++,containerId:clone.id});
    moduleClipboard.module={...clone,groupId:null,outerWallMm:projectOuterWallMm,innerWallMm:projectInnerWallMm};
    setSingleContainerSelection(clone.id);
    render();
  });

  createRowBtn?.addEventListener("click",()=>{
    const source=selectedContainer();
    if(!source || selectedContainerIds.size!==1) return;
    const count=clamp(Math.floor(Number(rowCountInput?.value)||1),1,30);
    let previous=source, last=source;
    for(let n=0;n<count;n++){
      const prevBounds=containerBounds(previous);
      const clone={...source,id:nextId++,x:source.x,y:source.y,groupId:null,outerWallMm:projectOuterWallMm,innerWallMm:projectInnerWallMm};
      const cloneBounds=containerBounds(clone);
      clone.x += (prevBounds.maxX + BUILD_JOINT) - cloneBounds.minX;
      items.push(clone);
      const attached=elements.filter(e=>e.containerId===source.id && (e.type==="door"||e.type==="window"));
      for(const e of attached) elements.push({...e,id:nextId++,containerId:clone.id});
      previous=clone; last=clone;
    }
    setSingleContainerSelection(last.id);
    render();
  });

  copyOpeningsBtn?.addEventListener("click",()=>{
    const source=selectedContainer(); if(!source)return;
