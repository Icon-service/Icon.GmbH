---
import { PLANNER_BAUREIHEN } from "../data/plannerCatalog";
import { useTranslations, type Lang } from "../i18n/utils";

type Props = { lang: Lang };
const { lang } = Astro.props as Props;
const t = useTranslations(lang);

// Same placeholder pattern as ContactForm.astro — replace before launch.
const FORMSPREE_ID = "YOUR_FORM_ID";
const action = `https://formspree.io/f/${FORMSPREE_ID}`;

const WORLD_W = 24;
const WORLD_H = 16;

const status = {
  sending: lang === "de" ? "Wird gesendet …" : "Sending …",
  success: lang === "de" ? "Danke — Ihre Skizze ist angekommen. Wir melden uns in Kürze." : "Thanks — your sketch has been sent. We'll be in touch shortly.",
  error: lang === "de" ? "Das hat leider nicht geklappt. Bitte versuchen Sie es erneut oder schreiben Sie uns direkt an info@icon.gmbh." : "Something went wrong. Please try again or email us directly at info@icon.gmbh.",
  empty: lang === "de" ? "Bitte platzieren Sie mindestens einen Container, bevor Sie die Skizze senden." : "Please place at least one container before sending the sketch.",
};
---

<div class="grid gap-8 lg:grid-cols-[300px_1fr]">
  <!-- Eigenschaften -->
  <div class="space-y-5">
    <div class="card p-4">
      <p class="text-xs font-bold uppercase tracking-wider text-steel">
        {lang === "de" ? "Container hinzufügen" : "Add container"}
      </p>
      <div class="mt-3 space-y-3">
        {PLANNER_BAUREIHEN.map((b) => (
          <div class="border-t border-line pt-3 first:border-t-0 first:pt-0">
            <p class="text-sm font-semibold text-ink">{b.label}</p>
            <div class="mt-2 flex gap-2">
              <select class="planner-size-select w-full rounded border border-line bg-paper px-2 py-1.5 text-sm text-ink focus:border-signal focus:outline-none" data-product={b.id} data-label={b.shortLabel}>
                {b.categories.map((cat) => (
                  <optgroup label={cat.label}>
                    {cat.types.map((t) => (
                      <option value={t.code}>{t.name} — {t.code} ({t.width}×{t.length} m)</option>
                    ))}
                  </optgroup>
                ))}
              </select>
              <button type="button" class="planner-add-btn btn-outline shrink-0 px-3 py-1.5 text-sm text-ink" data-product={b.id} data-label={b.shortLabel}>+</button>
            </div>
          </div>
        ))}
      </div>
    </div>

    <div class="card bg-mist p-4 text-xs text-steel">
      {lang === "de"
        ? "Rechtsklick auf die freie Fläche: Trennwand, Tür, Fenster oder Treppe hinzufügen (Esc bricht ab). Rechtsklick auf einen Container: drehen, gruppieren oder löschen. Rechtsklick auf eine platzierte Tür/Fenster/Trennwand: Ausführung ändern oder löschen — bei mehreren gleichzeitig ausgewählten (Shift + Klick) gilt die Änderung für alle. Navigation: Mausrad = Zoom, mittlere Maustaste gedrückt halten und ziehen = Plan verschieben."
        : "Right-click the empty canvas to add a partition, door, window or stair (Esc cancels). Right-click a container to rotate, group or delete it. Right-click a placed door/window/partition to change its options or delete it — with several selected at once (Shift + click), the change applies to all of them. Navigation: mouse wheel = zoom, hold the middle mouse button and drag = pan."}
    </div>

    <div class="card p-4">
      <p class="text-xs font-bold uppercase tracking-wider text-steel">{lang === "de" ? "Anlage" : "Building"}</p>
      <div class="mt-3 space-y-3">
        <label class="block text-xs font-semibold text-steel">{lang === "de" ? "Geschosse" : "Storeys"}
          <select id="planner-storeys" class="mt-1 w-full rounded border border-line bg-paper px-2 py-2 text-sm text-ink">
            <option value="1">1</option><option value="2">2</option><option value="3">3</option>
          </select>
        </label>
        <div class="border-t border-line pt-3">
          <p class="text-xs font-bold uppercase tracking-wider text-steel">{lang === "de" ? "Paneele – gesamte Anlage" : "Panels – entire building"}</p>
          <label class="mt-2 block text-xs font-semibold text-steel">{lang === "de" ? "Außenwand / Außenhülle" : "External wall / shell"}
            <select id="planner-outer-wall" class="mt-1 w-full rounded border border-line bg-paper px-2 py-2 text-sm text-ink">
              {[60,80,100,120,150,180,200].map((mm) => <option value={mm} selected={mm === 100}>{mm} mm</option>)}
            </select>
          </label>
          <label class="mt-3 block text-xs font-semibold text-steel">{lang === "de" ? "Trennwand je Container" : "Partition panel per container"}
            <select id="planner-inner-wall" class="mt-1 w-full rounded border border-line bg-paper px-2 py-2 text-sm text-ink">
              {[60,80,100,120,150,180,200].map((mm) => <option value={mm} selected={mm === 100}>{mm} mm</option>)}
            </select>
          </label>
          <p class="mt-2 text-xs text-steel">{lang === "de" ? "Diese beiden Werte gelten automatisch für alle vorhandenen und neu hinzugefügten Container. Zwei benachbarte Module mit 60 mm Trennwand ergeben 60 + 15 mm Montagefuge + 60 mm." : "These values automatically apply to all existing and newly added containers. Two adjacent modules with 60 mm partition panels result in 60 + 15 mm installation gap + 60 mm."}</p>
        </div>
        <p class="text-xs text-steel">{lang === "de" ? "Geschosszahl und Paneelstärken gelten als Projekteinstellungen für die komplette Anlage." : "Storey count and panel thicknesses are project settings for the entire building."}</p>
      </div>
    </div>

    <div id="planner-properties" class="card p-4">
      <p class="text-xs font-bold uppercase tracking-wider text-steel">{lang === "de" ? "Auswahl bearbeiten" : "Edit selection"}</p>
      <p id="planner-no-selection" class="mt-3 text-sm text-steel">{lang === "de" ? "Noch nichts ausgewählt." : "Nothing selected."}</p>
      <div id="planner-container-properties" class="mt-3 hidden space-y-3">
        <label class="block text-xs font-semibold text-steel">{lang === "de" ? "Baureihe" : "Series"}
          <select id="planner-selected-product" class="mt-1 w-full rounded border border-line bg-paper px-2 py-2 text-sm text-ink">
            {PLANNER_BAUREIHEN.map((b) => <option value={b.id}>{b.label}</option>)}
          </select>
        </label>
        <label class="block text-xs font-semibold text-steel">{lang === "de" ? "Typ" : "Type"}
          <select id="planner-selected-size" class="mt-1 w-full rounded border border-line bg-paper px-2 py-2 text-sm text-ink">
            {PLANNER_BAUREIHEN[0].categories.map((cat) => (
              <optgroup label={cat.label}>
                {cat.types.map((t) => (
                  <option value={t.code}>{t.name} — {t.code} ({t.width}×{t.length} m)</option>
                ))}
              </optgroup>
            ))}
          </select>
        </label>
        <div id="planner-group-name-wrap" class="hidden">
          <label class="block text-xs font-semibold text-steel">{lang === "de" ? "Raumname der Gruppe" : "Group room name"}
            <input id="planner-group-name" type="text" placeholder={lang === "de" ? "z. B. Großraumbüro" : "e.g. Open-plan office"} class="mt-1 w-full rounded border border-line bg-paper px-2 py-2 text-sm text-ink" />
          </label>
          <p class="mt-1 text-xs text-steel">{lang === "de" ? "Im PDF erscheint dieser Name einmal mittig über der gemeinsamen Nettofläche." : "In the PDF this name appears once above the common net area."}</p>
        </div>
        <div class="rounded border border-line bg-mist p-3 text-xs text-steel">
          {lang === "de" ? "Paneelstärken werden zentral unter „Anlage“ eingestellt und gelten für alle Module." : "Panel thicknesses are configured centrally under Building and apply to every module."}
        </div>
        <div class="rounded border border-line bg-mist p-3">
          <div class="flex items-center justify-between gap-3 text-sm"><span class="text-steel">{lang === "de" ? "Außenfläche" : "Gross area"}</span><strong id="planner-gross-area" class="text-ink">–</strong></div>
          <div class="mt-1 flex items-center justify-between gap-3 text-sm"><span class="text-steel">{lang === "de" ? "Innenfläche netto" : "Net internal area"}</span><strong id="planner-net-area" class="text-ink">–</strong></div>
          <div class="mt-1 text-xs text-steel">{lang === "de" ? "Nettofläche wird aus den Außenmaßen abzüglich der gewählten Außenpaneele berechnet." : "Net area is calculated from external dimensions minus the selected outer panels."}</div>
        </div>
        <div id="planner-opening-actions" class="border-t border-line pt-3">
          <p class="text-xs font-semibold text-steel">{lang === "de" ? "Öffnungen schneller bearbeiten" : "Faster opening workflow"}</p>
          <button type="button" id="planner-copy-openings" class="btn-outline mt-2 w-full px-3 py-2 text-sm text-ink">{lang === "de" ? "Öffnungen auf gleiche Module übernehmen" : "Copy openings to matching modules"}</button>
          <p class="mt-1 text-xs text-steel">{lang === "de" ? "Kopiert Türen und Fenster dieses Moduls auf alle Container mit gleichem Typ, gleicher Größe und Ausrichtung." : "Copies this module's doors and windows to all containers with the same type, size and orientation."}</p>
        </div>
        <div class="border-t border-line pt-3">
          <p class="text-xs font-semibold text-steel">{lang === "de" ? "Modul vervielfältigen" : "Duplicate module"}</p>
          <div class="mt-2 grid grid-cols-2 gap-2">
            <button type="button" id="planner-copy-module" class="btn-outline px-3 py-2 text-sm text-ink">{lang === "de" ? "Kopieren" : "Copy"}</button>
            <button type="button" id="planner-paste-module" class="btn-outline px-3 py-2 text-sm text-ink" disabled>{lang === "de" ? "Einfügen" : "Paste"}</button>
          </div>
          <label class="mt-3 block text-xs font-semibold text-steel">{lang === "de" ? "Reihe – Anzahl Kopien" : "Row – number of copies"}
            <div class="mt-1 flex gap-2">
              <input id="planner-row-count" type="number" min="1" max="30" step="1" value="3" class="w-full rounded border border-line bg-paper px-2 py-2 text-sm text-ink" />
              <button type="button" id="planner-create-row" class="btn-outline shrink-0 px-3 py-2 text-sm text-ink">{lang === "de" ? "Reihe" : "Row"}</button>
            </div>
          </label>
          <p class="mt-1 text-xs text-steel">{lang === "de" ? "Kopiert das ausgewählte Modul vollständig inklusive Türen/Fenstern. Reihe erzeugt die gewünschte Anzahl Kopien nach rechts (X-Achse) mit automatisch 15 mm Montageabstand." : "Copies the selected module including doors/windows. Row creates the requested copies to the right on the X axis with an automatic 15 mm installation gap."}</p>
        </div>
      </div>
      <div id="planner-element-properties" class="mt-3 hidden space-y-3">
        <label class="block text-xs font-semibold text-steel">{lang === "de" ? "Breite" : "Width"}
          <div class="mt-1 flex items-center gap-2"><input id="planner-element-width" type="range" min="0.6" max="2.4" step="0.1" value="0.9" class="w-full" /><span id="planner-element-width-value" class="w-14 text-right text-sm text-ink">0.9 m</span></div>
        </label>
        <div id="planner-door-options" class="hidden space-y-3 border-t border-line pt-3">
          <label class="block text-xs font-semibold text-steel">{lang === "de" ? "Öffnungsrichtung" : "Swing direction"}
            <select id="planner-door-swing" class="mt-1 w-full rounded border border-line bg-paper px-2 py-2 text-sm text-ink">
              <option value="inside">{lang === "de" ? "Nach innen" : "Inward"}</option>
              <option value="outside">{lang === "de" ? "Nach außen" : "Outward"}</option>
            </select>
          </label>
          <label class="block text-xs font-semibold text-steel">{lang === "de" ? "Anschlag" : "Hinge side"}
            <select id="planner-door-hinge" class="mt-1 w-full rounded border border-line bg-paper px-2 py-2 text-sm text-ink">
              <option value="left">{lang === "de" ? "Links" : "Left"}</option>
              <option value="right">{lang === "de" ? "Rechts" : "Right"}</option>
            </select>
          </label>
        </div>
        <div id="planner-window-options" class="hidden space-y-3 border-t border-line pt-3">
          <label class="block text-xs font-semibold text-steel">{lang === "de" ? "Fenstertyp" : "Window type"}
            <select id="planner-window-type" class="mt-1 w-full rounded border border-line bg-paper px-2 py-2 text-sm text-ink">
              <option value="single">{lang === "de" ? "Einfach" : "Single"}</option>
              <option value="double">{lang === "de" ? "Doppelt" : "Double"}</option>
            </select>
          </label>
          <label class="block text-xs font-semibold text-steel">{lang === "de" ? "Rollladen" : "Roller shutter"}
            <select id="planner-window-shutter" class="mt-1 w-full rounded border border-line bg-paper px-2 py-2 text-sm text-ink">
              <option value="none">{lang === "de" ? "Ohne Rollladen" : "Without shutter"}</option>
              <option value="roller">{lang === "de" ? "Mit Rollladen" : "With shutter"}</option>
            </select>
          </label>
        </div>
        <div id="planner-stair-options" class="hidden space-y-3 border-t border-line pt-3">
          <label class="block text-xs font-semibold text-steel">{lang === "de" ? "Treppenbreite" : "Stair width"}
            <select id="planner-stair-width" class="mt-1 w-full rounded border border-line bg-paper px-2 py-2 text-sm text-ink">
              <option value="1.0">1,00 m</option><option value="1.2" selected>1,20 m</option><option value="1.5">1,50 m</option>
            </select>
          </label>
          <label class="block text-xs font-semibold text-steel">{lang === "de" ? "Treppenlänge" : "Stair length"}
            <select id="planner-stair-length" class="mt-1 w-full rounded border border-line bg-paper px-2 py-2 text-sm text-ink">
              <option value="2.5">2,50 m</option><option value="3.0" selected>3,00 m</option><option value="3.5">3,50 m</option><option value="4.0">4,00 m</option>
            </select>
          </label>
        </div>
        <label id="planner-wall-thickness-wrap" class="block text-xs font-semibold text-steel">{lang === "de" ? "Wandstärke" : "Wall thickness"}
          <select id="planner-wall-thickness" class="mt-1 w-full rounded border border-line bg-paper px-2 py-2 text-sm text-ink">
            {[60,80,100,120,150,180,200].map((mm) => <option value={mm} selected={mm === 100}>{mm} mm</option>)}
          </select>
        </label>
      </div>
    </div>
  </div>

  <!-- Canvas -->
  <div>
    <div class="flex flex-wrap items-center justify-between gap-3 border-b border-line pb-3">
      <div class="flex flex-wrap gap-2">
        <button type="button" id="planner-rotate" class="btn-outline px-3 py-1.5 text-sm text-ink" disabled>{lang === "de" ? "Drehen" : "Rotate"}</button>
        <button type="button" id="planner-delete" class="btn-outline px-3 py-1.5 text-sm text-ink" disabled>{lang === "de" ? "Löschen" : "Delete"}</button>
        <button type="button" id="planner-group" class="btn-outline px-3 py-1.5 text-sm text-ink" disabled>{lang === "de" ? "Gruppieren" : "Group"}</button>
        <button type="button" id="planner-ungroup" class="btn-outline px-3 py-1.5 text-sm text-ink" disabled>{lang === "de" ? "Gruppe lösen" : "Ungroup"}</button>
        <button type="button" id="planner-clear" class="btn-outline px-3 py-1.5 text-sm text-ink">{lang === "de" ? "Zurücksetzen" : "Reset"}</button>
      </div>
      <div class="flex flex-wrap gap-2">
        <button type="button" id="planner-zoom-out" class="btn-outline px-3 py-1.5 text-sm text-ink" aria-label="Zoom out">−</button>
        <button type="button" id="planner-zoom-reset" class="btn-outline px-3 py-1.5 text-sm text-ink">100%</button>
        <button type="button" id="planner-zoom-in" class="btn-outline px-3 py-1.5 text-sm text-ink" aria-label="Zoom in">+</button>
        <button type="button" id="planner-export" class="btn-outline px-3 py-1.5 text-sm text-ink">{lang === "de" ? "PDF mit Maßen" : "PDF with dimensions"}</button>
      </div>
    </div>

    <div id="planner-total-summary" class="mt-3 flex flex-wrap gap-x-5 gap-y-1 text-xs text-steel">
      <span>{lang === "de" ? "Gesamt:" : "Total:"} <strong id="planner-total-modules" class="text-ink">0</strong></span>
      <span>{lang === "de" ? "Brutto:" : "Gross:"} <strong id="planner-total-gross" class="text-ink">0.00 m²</strong></span>
      <span>{lang === "de" ? "Netto innen:" : "Net internal:"} <strong id="planner-total-net" class="text-ink">0.00 m²</strong></span>
    </div>

    <div class="mt-4 overflow-hidden rounded border border-line" style="overscroll-behavior: contain;">
      <svg id="planner-svg" viewBox={`0 0 ${WORLD_W} ${WORLD_H}`} class="block w-full touch-none select-none bg-mist" style="aspect-ratio: 3 / 2; overscroll-behavior: contain;">
        <defs>
          <pattern id="planner-grid" width="1" height="1" patternUnits="userSpaceOnUse"><path d="M 1 0 L 0 0 0 1" fill="none" stroke="#dde2e5" stroke-width="0.02"></path></pattern>
          <marker id="dim-arrow" viewBox="0 0 10 10" refX="5" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse"><path d="M 0 0 L 10 5 L 0 10 z" fill="#5f666b"></path></marker>
        </defs>
        <rect id="planner-grid-bg" width={WORLD_W} height={WORLD_H} fill="url(#planner-grid)"></rect>
        <g id="planner-items"></g>
        <g id="planner-elements"></g>
        <g id="planner-overlay" pointer-events="none"></g>
      </svg>
    </div>
    <p class="mt-2 text-xs text-steel">{lang === "de" ? "1 Kästchen = 1 m · Mausrad = Zoom · Mittlere Maustaste + Ziehen = Verschieben · Module rasten mit 15 mm sichtbarem Abstand zueinander ein · Shift + Klick = Mehrfachauswahl." : "1 square = 1 m · Mouse wheel = zoom · Middle mouse + drag = pan · Modules snap together with a 15 mm installation joint · Shift + click = multi-select."}</p>
  </div>
</div>

<!-- Rechtsklick-Menü: freie Fläche -->
<div id="planner-menu-empty" class="planner-ctx-menu card hidden fixed z-50 w-52 bg-paper p-1.5 shadow-xl">
  <p class="px-3 py-1.5 text-xs font-bold uppercase tracking-wider text-steel">{lang === "de" ? "Bauteil hinzufügen" : "Add element"}</p>
  <ul>
    <li><button type="button" class="planner-ctx-tool w-full rounded px-3 py-2 text-left text-sm text-ink hover:bg-mist" data-tool="wall">{lang === "de" ? "Trennwand zeichnen" : "Draw partition"}</button></li>
    <li><button type="button" class="planner-ctx-tool w-full rounded px-3 py-2 text-left text-sm text-ink hover:bg-mist" data-tool="door">{lang === "de" ? "Tür setzen" : "Place door"}</button></li>
    <li><button type="button" class="planner-ctx-tool w-full rounded px-3 py-2 text-left text-sm text-ink hover:bg-mist" data-tool="window">{lang === "de" ? "Fenster setzen" : "Place window"}</button></li>
    <li><button type="button" class="planner-ctx-tool w-full rounded px-3 py-2 text-left text-sm text-ink hover:bg-mist" data-tool="stair">{lang === "de" ? "Außentreppe setzen" : "Place external stair"}</button></li>
  </ul>
</div>

<!-- Rechtsklick-Menü: Container -->
<div id="planner-menu-container" class="planner-ctx-menu card hidden fixed z-50 w-48 bg-paper p-1.5 shadow-xl">
  <ul>
    <li><button type="button" id="planner-ctx-rotate" class="w-full rounded px-3 py-2 text-left text-sm text-ink hover:bg-mist">{lang === "de" ? "Drehen" : "Rotate"}</button></li>
    <li><button type="button" id="planner-ctx-group" class="w-full rounded px-3 py-2 text-left text-sm text-ink hover:bg-mist">{lang === "de" ? "Gruppieren" : "Group"}</button></li>
    <li><button type="button" id="planner-ctx-ungroup" class="w-full rounded px-3 py-2 text-left text-sm text-ink hover:bg-mist">{lang === "de" ? "Gruppe lösen" : "Ungroup"}</button></li>
    <li><div class="my-1.5 border-t border-line"></div></li>
    <li><button type="button" id="planner-ctx-delete" class="w-full rounded px-3 py-2 text-left text-sm text-signal hover:bg-mist">{lang === "de" ? "Löschen" : "Delete"}</button></li>
  </ul>
</div>

<!-- Rechtsklick-Menü: Fenster -->
<div id="planner-menu-window" class="planner-ctx-menu card hidden fixed z-50 w-56 bg-paper p-1.5 shadow-xl">
  <p id="planner-menu-window-count" class="hidden px-3 py-1.5 text-xs font-semibold text-steel"></p>
  <ul>
    <li class="group relative">
      <div class="flex cursor-default items-center justify-between rounded px-3 py-2 text-sm text-ink hover:bg-mist"><span>{lang === "de" ? "Fenstertyp" : "Window type"}</span><span class="text-steel">&rsaquo;</span></div>
      <ul class="absolute left-full top-0 hidden w-32 rounded border border-line bg-paper p-1.5 shadow-xl group-hover:block">
        <li><button type="button" class="planner-ctx-window-type w-full rounded px-3 py-1.5 text-left text-sm text-ink hover:bg-mist" data-value="single">{lang === "de" ? "Einfach" : "Single"}</button></li>
        <li><button type="button" class="planner-ctx-window-type w-full rounded px-3 py-1.5 text-left text-sm text-ink hover:bg-mist" data-value="double">{lang === "de" ? "Doppelt" : "Double"}</button></li>
      </ul>
    </li>
    <li class="group relative">
      <div class="flex cursor-default items-center justify-between rounded px-3 py-2 text-sm text-ink hover:bg-mist"><span>{lang === "de" ? "Rollladen" : "Roller shutter"}</span><span class="text-steel">&rsaquo;</span></div>
      <ul class="absolute left-full top-0 hidden w-32 rounded border border-line bg-paper p-1.5 shadow-xl group-hover:block">
        <li><button type="button" class="planner-ctx-window-shutter w-full rounded px-3 py-1.5 text-left text-sm text-ink hover:bg-mist" data-value="none">{lang === "de" ? "Ohne" : "Without"}</button></li>
        <li><button type="button" class="planner-ctx-window-shutter w-full rounded px-3 py-1.5 text-left text-sm text-ink hover:bg-mist" data-value="roller">{lang === "de" ? "Mit" : "With"}</button></li>
      </ul>
    </li>
    <li class="group relative">
      <div class="flex cursor-default items-center justify-between rounded px-3 py-2 text-sm text-ink hover:bg-mist"><span>{lang === "de" ? "Breite" : "Width"}</span><span class="text-steel">&rsaquo;</span></div>
      <ul class="absolute left-full top-0 hidden w-24 rounded border border-line bg-paper p-1.5 shadow-xl group-hover:block">
        {[0.6, 0.9, 1.2, 1.5, 1.8].map((w) => (
          <li><button type="button" class="planner-ctx-window-width w-full rounded px-3 py-1.5 text-left text-sm text-ink hover:bg-mist" data-value={w}>{w.toFixed(1)} m</button></li>
        ))}
      </ul>
    </li>
    <li><div class="my-1.5 border-t border-line"></div></li>
