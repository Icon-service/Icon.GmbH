---
import { getLangFromUrl, useTranslations, localizedPath } from "../i18n/utils";

type Props = { altPath?: string };
const { altPath } = Astro.props as Props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const otherLang = lang === "de" ? "en" : "de";
const switchHref = altPath ?? (lang === "de" ? "/en" : "/");

const nav = [
  { href: localizedPath("services", lang), label: t("nav.services") },
  { href: localizedPath("models", lang), label: t("nav.models") },
  { href: localizedPath("references", lang), label: t("nav.references") },
  { href: localizedPath("about", lang), label: t("nav.about") },
];
const home = lang === "en" ? "/en" : "/";
---

<header class="border-b border-line bg-paper">
  <div class="mx-auto flex max-w-(--container-wide) items-center justify-between gap-6 px-6 py-4">
    <a href={home} class="text-[1.35rem] font-extrabold tracking-tight text-ink">
      ICON <span class="text-signal">GmbH</span>
    </a>

    <nav class="hidden items-center gap-5 md:flex">
      {nav.map((item) => (
        <a href={item.href} class="text-[0.93rem] font-semibold text-ink hover:text-signal">
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-4">
      <a
        href={switchHref}
        class="text-xs font-semibold uppercase tracking-widest text-steel hover:text-signal"
        aria-label={`Switch to ${otherLang === "de" ? "Deutsch" : "English"}`}
      >
        {lang === "de" ? "DE" : "EN"} <span class="text-steel/40">/</span> {otherLang.toUpperCase()}
      </a>
      <a href={localizedPath("contact", lang)} class="btn-primary hidden text-sm sm:inline-block">
        {t("nav.cta")}
      </a>
    </div>
  </div>
</header>
