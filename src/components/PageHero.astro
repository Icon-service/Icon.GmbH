---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

type Props = {
  eyebrow: string;
  title: string;
  lead: string;
  image?: ImageMetadata;
  imageAlt?: string;
  imageCaption?: string;
  reverse?: boolean;
  titleClass?: string;
  priority?: boolean;
  backHref?: string;
  backLabel?: string;
};

const {
  eyebrow,
  title,
  lead,
  image,
  imageAlt,
  imageCaption,
  reverse = false,
  titleClass = "text-4xl sm:text-5xl",
  priority = false,
  backHref,
  backLabel,
} = Astro.props as Props;
---

<div
  class:list={[
    "mx-auto grid max-w-(--container-wide) gap-10 px-6 py-16 lg:py-20",
    image && "lg:grid-cols-[1.05fr_1fr] lg:items-center",
  ]}
>
  <div class:list={[reverse && image && "lg:order-2"]}>
    {backHref && (
      <a href={backHref} class="mb-4 inline-block text-sm font-semibold text-steel hover:text-signal">
        ← {backLabel}
      </a>
    )}
    <div class="flex items-center gap-3">
      <span class="h-[2px] w-8 bg-signal" aria-hidden="true"></span>
      <p class="icon-topline">{eyebrow}</p>
    </div>
    <h1 class:list={["mt-4", titleClass]}>{title}</h1>
    <p class="mt-4 max-w-xl text-lg text-steel">{lead}</p>
    <div class="mt-8">
      <slot />
    </div>
  </div>

  {image && (
    <div class:list={["relative", reverse && "lg:order-1"]}>
      <Image
        src={image}
        alt={imageAlt ?? title}
        class="aspect-4/3 w-full rounded-xl object-cover shadow-xl shadow-ink/10 ring-1 ring-ink/5"
        widths={[480, 768, 1024]}
        sizes="(min-width: 1024px) 45vw, 100vw"
        loading={priority ? "eager" : "lazy"}
        fetchpriority={priority ? "high" : "auto"}
      />
      {imageCaption && (
        <p class="absolute bottom-4 left-4 rounded bg-ink/80 px-3 py-1.5 text-xs font-semibold text-paper backdrop-blur-sm">
          {imageCaption}
        </p>
      )}
    </div>
  )}
</div>
